     'usb.c',
   )
 endif
diff --git a/src/scanner.c b/src/scanner.c
new file mode 100644
index 0000000..0d63e9f
--- /dev/null
+++ b/src/scanner.c
@@ -0,0 +1,502 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright © the xdg-desktop-portal contributors
+ */
+
+#include "config.h"
+
+#include "scanner.h"
+
+#include <string.h>
+
+#include <gio/gio.h>
+
+#include "xdp-context.h"
+#include "xdp-dbus.h"
+#include "xdp-impl-dbus.h"
+#include "xdp-portal-config.h"
+#include "xdp-request.h"
+#include "xdp-utils.h"
+
+/* Scanners are listed by id, and an application only ever sees the ones the user chose for it.
+ * The choice is kept in memory for as long as the application stays on the bus. */
+
+struct _XdpScanner
+{
+  XdpDbusScannerSkeleton parent_instance;
+
+  XdpContext *context;
+  XdpDbusImplScanner *impl;
+
+  GMutex mutex;
+};
+
+#define XDP_TYPE_SCANNER (xdp_scanner_get_type ())
+G_DECLARE_FINAL_TYPE (XdpScanner, xdp_scanner, XDP, SCANNER, XdpDbusScannerSkeleton);
+
+static void xdp_scanner_iface_init (XdpDbusScannerIface *iface);
+
+G_DEFINE_FINAL_TYPE_WITH_CODE (XdpScanner, xdp_scanner, XDP_DBUS_TYPE_SCANNER_SKELETON,
+                               G_IMPLEMENT_INTERFACE (XDP_DBUS_TYPE_SCANNER, xdp_scanner_iface_init));
+
+#define GRANTS_KEY "-xdp-scanner-grants"
+
+/* The scanners the user has chosen for one application: a set of ids */
+static GHashTable *
+scanner_grants_from_app_info (XdpAppInfo *app_info)
+{
+  GHashTable *grants = g_object_get_data (G_OBJECT (app_info), GRANTS_KEY);
+
+  if (grants == NULL)
+    {
+      grants = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+      g_object_set_data_full (G_OBJECT (app_info), GRANTS_KEY, grants,
+                              (GDestroyNotify) g_hash_table_unref);
+    }
+
+  return grants;
+}
+
+/* ---- The scanners the host has ----
+ *
+ * One entry per scanner: an opaque id and the information vardict that ListScanners returns,
+ * with the keys name, vendor, model, backend, kind, type, capabilities and available.
+ */
+
+typedef struct
+{
+  char *id;
+  GVariant *info; /* a{sv}, floating reference sunk */
+  GStrv capabilities;
+} ScannerDevice;
+
+static void
+scanner_device_free (ScannerDevice *device)
+{
+  g_free (device->id);
+  g_clear_pointer (&device->info, g_variant_unref);
+  g_strfreev (device->capabilities);
+  g_free (device);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (ScannerDevice, scanner_device_free)
+
+static ScannerDevice *
+scanner_device_new (const char *id,
+                    const char *name,
+                    const char *kind,
+                    const char *type,
+                    const char * const *capabilities,
+                    gboolean available)
+{
+  ScannerDevice *device = g_new0 (ScannerDevice, 1);
+  GVariantBuilder builder;
+
+  device->id = g_strdup (id);
+  device->capabilities = g_strdupv ((char **) capabilities);
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&builder, "{sv}", "name", g_variant_new_string (name));
+  g_variant_builder_add (&builder, "{sv}", "backend", g_variant_new_string ("fake"));
+  g_variant_builder_add (&builder, "{sv}", "kind", g_variant_new_string (kind));
+  g_variant_builder_add (&builder, "{sv}", "type", g_variant_new_string (type));
+  g_variant_builder_add (&builder, "{sv}", "capabilities",
+                         g_variant_new_strv (capabilities, -1));
+  g_variant_builder_add (&builder, "{sv}", "available", g_variant_new_boolean (available));
+  device->info = g_variant_ref_sink (g_variant_builder_end (&builder));
+
+  return device;
+}
+
+/* The scanners that exist right now, as a list of ScannerDevice. This stands in for the helper
+ * that will ask libsane; until then XDG_DESKTOP_PORTAL_SCANNER_FAKE=1 gives two made-up ones. */
+static GPtrArray *
+scanner_enumerate (XdpScanner *self)
+{
+  GPtrArray *devices = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_device_free);
+
+  if (g_strcmp0 (g_getenv ("XDG_DESKTOP_PORTAL_SCANNER_FAKE"), "1") == 0)
+    {
+      static const char * const film[] = { "film", "infrared", "color", NULL };
+      static const char * const mfp[] = { "flatbed", "adf", "color", NULL };
+
+      g_ptr_array_add (devices,
+                       scanner_device_new ("fake-film", "Fake Film Scanner", "usb",
+                                           "film scanner", film, TRUE));
+      g_ptr_array_add (devices,
+                       scanner_device_new ("fake-mfp", "Fake Office Printer", "network",
+                                           "multi-function peripheral", mfp, TRUE));
+    }
+
+  return devices;
+}
+
+static gboolean
+scanner_device_has_capabilities (ScannerDevice       *device,
+                                 const char * const  *required)
+{
+  for (size_t i = 0; required && required[i]; i++)
+    {
+      if (!g_strv_contains ((const char * const *) device->capabilities, required[i]))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+static GVariant *
+scanner_device_to_variant (ScannerDevice *device)
+{
+  return g_variant_new ("(s@a{sv})", device->id, device->info);
+}
+
+/* ---- ListScanners ---- */
+
+static gboolean
+handle_list_scanners (XdpDbusScanner         *object,
+                      GDBusMethodInvocation  *invocation,
+                      GVariant               *arg_options)
+{
+  XdpScanner *self = XDP_SCANNER (object);
+  XdpAppInfo *app_info = xdp_invocation_get_app_info (invocation);
+  g_autoptr(GPtrArray) devices = NULL;
+  g_autoptr(GError) error = NULL;
+  GVariantBuilder options_builder;
+  GVariantBuilder scanners_builder;
+  GHashTable *grants;
+
+  g_debug ("[scanner] Handling ListScanners");
+
+  g_variant_builder_init (&options_builder, G_VARIANT_TYPE_VARDICT);
+  if (!xdp_filter_options (arg_options, &options_builder, NULL, 0, NULL, &error))
+    {
+      g_variant_builder_clear (&options_builder);
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+  g_variant_builder_clear (&options_builder);
+
+  devices = scanner_enumerate (self);
+
+  g_variant_builder_init (&scanners_builder, G_VARIANT_TYPE ("a(sa{sv})"));
+
+  g_mutex_lock (&self->mutex);
+  grants = scanner_grants_from_app_info (app_info);
+  for (guint i = 0; i < devices->len; i++)
+    {
+      ScannerDevice *device = g_ptr_array_index (devices, i);
+
+      if (g_hash_table_contains (grants, device->id))
+        g_variant_builder_add_value (&scanners_builder, scanner_device_to_variant (device));
+    }
+  g_mutex_unlock (&self->mutex);
+
+  xdp_dbus_scanner_complete_list_scanners (object, invocation,
+                                           g_variant_builder_end (&scanners_builder));
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+/* ---- SelectScanners ---- */
+
+typedef struct
+{
+  XdpScanner *scanner;
+  gboolean multiple;
+  GHashTable *candidates; /* id → GVariant (s, a{sv}) */
+} SelectData;
+
+static void
+select_data_free (SelectData *data)
+{
+  g_clear_object (&data->scanner);
+  g_clear_pointer (&data->candidates, g_hash_table_unref);
+  g_free (data);
+}
+
+static void
+select_scanners_cb (GObject      *source_object,
+                    GAsyncResult *result,
+                    gpointer      user_data)
+{
+  g_autoptr(XdpRequest) request = user_data;
+  g_autoptr(GVariant) results = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree const char **ids = NULL;
+  GVariantBuilder results_builder;
+  GVariantBuilder chosen_builder;
+  XdpScanner *self;
+  SelectData *data;
+  GHashTable *grants;
+  guint response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+  guint n_chosen = 0;
+
+  REQUEST_AUTOLOCK (request);
+
+  data = g_object_get_data (G_OBJECT (request), "scanner-select");
+  self = data->scanner;
+
+  g_variant_builder_init (&results_builder, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_init (&chosen_builder, G_VARIANT_TYPE ("a(sa{sv})"));
+
+  if (!xdp_dbus_impl_scanner_call_select_scanners_finish (self->impl, &response, &results,
+                                                          result, &error))
+    {
+      response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+      g_dbus_error_strip_remote_error (error);
+      g_warning ("[scanner] The backend failed to select scanners: %s", error->message);
+      goto out;
+    }
+
+  if (response != XDG_DESKTOP_PORTAL_RESPONSE_SUCCESS)
+    goto out;
+
+  if (!g_variant_lookup (results, "scanners", "^a&s", &ids))
+    {
+      response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+      goto out;
+    }
+
+  g_mutex_lock (&self->mutex);
+  grants = scanner_grants_from_app_info (request->app_info);
+
+  /* Only scanners the application was offered can be granted, and one if it asked for one. The
+   * backend is trusted to draw the dialog, not to widen what the application may use. */
+  for (size_t i = 0; ids[i] != NULL; i++)
+    {
+      GVariant *candidate = g_hash_table_lookup (data->candidates, ids[i]);
+
+      if (candidate == NULL || (!data->multiple && n_chosen == 1))
+        continue;
+
+      g_hash_table_add (grants, g_strdup (ids[i]));
+      g_variant_builder_add_value (&chosen_builder, candidate);
+      n_chosen++;
+    }
+  g_mutex_unlock (&self->mutex);
+
+  if (n_chosen == 0)
+    response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+
+out:
+  if (response == XDG_DESKTOP_PORTAL_RESPONSE_SUCCESS)
+    g_variant_builder_add (&results_builder, "{sv}", "scanners",
+                           g_variant_builder_end (&chosen_builder));
+  else
+    g_variant_builder_clear (&chosen_builder);
+
+  if (request->exported)
+    {
+      xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request), response,
+                                      g_variant_builder_end (&results_builder));
+      xdp_request_unexport (request);
+    }
+  else
+    {
+      g_variant_builder_clear (&results_builder);
+    }
+}
+
+static gboolean
+validate_required_capabilities (const char  *key,
+                                GVariant    *value,
+                                GVariant    *options,
+                                gpointer     user_data,
+                                GError     **error)
+{
+  /* Unknown capabilities are ignored, as the documentation says, so any list is valid */
+  return TRUE;
+}
+
+static gboolean
+handle_select_scanners (XdpDbusScanner         *object,
+                        GDBusMethodInvocation  *invocation,
+                        const char             *arg_parent_window,
+                        GVariant               *arg_options)
+{
+  XdpScanner *self = XDP_SCANNER (object);
+  g_autoptr(XdpDbusImplRequest) impl_request = NULL;
+  g_autoptr(GPtrArray) devices = NULL;
+  g_autoptr(GVariant) impl_options = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree const char **required = NULL;
+  GVariantBuilder options_builder;
+  GVariantBuilder offered_builder;
+  SelectData *data;
+  XdpRequest *request;
+  GVariant *offered;
+  gboolean multiple = FALSE;
+
+  static const XdpOptionKey scanner_select_options[] = {
+    { "modal", G_VARIANT_TYPE_BOOLEAN, NULL },
+    { "multiple", G_VARIANT_TYPE_BOOLEAN, NULL },
+    { "accept_label", G_VARIANT_TYPE_STRING, NULL },
+    { "title", G_VARIANT_TYPE_STRING, NULL },
+    { "required_capabilities", G_VARIANT_TYPE_STRING_ARRAY, validate_required_capabilities },
+  };
+
+  request = xdp_request_from_invocation (invocation);
+
+  g_debug ("[scanner] Handling SelectScanners");
+
+  REQUEST_AUTOLOCK (request);
+
+  g_variant_builder_init (&options_builder, G_VARIANT_TYPE_VARDICT);
+  if (!xdp_filter_options (arg_options, &options_builder,
+                           scanner_select_options, G_N_ELEMENTS (scanner_select_options),
+                           NULL, &error))
+    {
+      g_variant_builder_clear (&options_builder);
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+  impl_options = g_variant_ref_sink (g_variant_builder_end (&options_builder));
+
+  g_variant_lookup (impl_options, "multiple", "b", &multiple);
+  g_variant_lookup (impl_options, "required_capabilities", "^a&s", &required);
+
+  /* The scanners the dialog may offer: all that exist and have what the application asked for.
+   * The application never sees this list, only what the user picks from it. */
+  devices = scanner_enumerate (self);
+
+  data = g_new0 (SelectData, 1);
+  data->scanner = g_object_ref (self);
+  data->multiple = multiple;
+  data->candidates = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                            g_free, (GDestroyNotify) g_variant_unref);
+
+  g_variant_builder_init (&offered_builder, G_VARIANT_TYPE ("a(sa{sv})"));
+  for (guint i = 0; i < devices->len; i++)
+    {
+      ScannerDevice *device = g_ptr_array_index (devices, i);
+      GVariant *entry;
+
+      if (!scanner_device_has_capabilities (device, (const char * const *) required))
+        continue;
+
+      entry = g_variant_ref_sink (scanner_device_to_variant (device));
+      g_hash_table_insert (data->candidates, g_strdup (device->id), entry);
+      g_variant_builder_add_value (&offered_builder, entry);
+    }
+  offered = g_variant_ref_sink (g_variant_builder_end (&offered_builder));
+
+  impl_request = xdp_dbus_impl_request_proxy_new_sync (
+    g_dbus_proxy_get_connection (G_DBUS_PROXY (self->impl)),
+    G_DBUS_PROXY_FLAGS_NONE,
+    g_dbus_proxy_get_name (G_DBUS_PROXY (self->impl)),
+    request->id,
+    NULL,
+    &error);
+  if (!impl_request)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      select_data_free (data);
+      g_variant_unref (offered);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_request_set_impl_request (request, impl_request);
+  xdp_request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  g_object_set_data_full (G_OBJECT (request), "scanner-select", data,
+                          (GDestroyNotify) select_data_free);
+
+  xdp_dbus_impl_scanner_call_select_scanners (self->impl,
+                                              request->id,
+                                              arg_parent_window,
+                                              xdp_app_info_get_id (request->app_info),
+                                              offered,
+                                              impl_options,
+                                              NULL,
+                                              select_scanners_cb,
+                                              g_object_ref (request));
+  g_variant_unref (offered);
+
+  xdp_dbus_scanner_complete_select_scanners (object, invocation, request->id);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static void
+xdp_scanner_iface_init (XdpDbusScannerIface *iface)
+{
+  iface->handle_list_scanners = handle_list_scanners;
+  iface->handle_select_scanners = handle_select_scanners;
+}
+
+static void
+xdp_scanner_dispose (GObject *object)
+{
+  XdpScanner *self = XDP_SCANNER (object);
+
+  g_clear_object (&self->impl);
+  g_mutex_clear (&self->mutex);
+
+  G_OBJECT_CLASS (xdp_scanner_parent_class)->dispose (object);
+}
+
+static void
+xdp_scanner_class_init (XdpScannerClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = xdp_scanner_dispose;
+}
+
+static void
+xdp_scanner_init (XdpScanner *self)
+{
+  g_mutex_init (&self->mutex);
+}
+
+static XdpScanner *
+scanner_new (XdpContext           *context,
+             XdpDbusImplScanner   *impl)
+{
+  XdpScanner *scanner;
+
+  g_debug ("[scanner] Initializing scanner portal");
+
+  scanner = g_object_new (xdp_scanner_get_type (), NULL);
+  scanner->context = context;
+  scanner->impl = g_object_ref (impl);
+
+  /* The dialog waits for the user, however long they take */
+  g_dbus_proxy_set_default_timeout (G_DBUS_PROXY (scanner->impl), G_MAXINT);
+
+  xdp_dbus_scanner_set_version (XDP_DBUS_SCANNER (scanner), 1);
+
+  return scanner;
+}
+
+void
+init_scanner (XdpContext *context)
+{
+  g_autoptr(XdpScanner) scanner = NULL;
+  GDBusConnection *connection = xdp_context_get_connection (context);
+  XdpPortalConfig *config = xdp_context_get_config (context);
+  XdpImplConfig *impl_config;
+  g_autoptr(XdpDbusImplScanner) impl = NULL;
+  g_autoptr(GError) error = NULL;
+
+  impl_config = xdp_portal_config_find (config, SCANNER_DBUS_IMPL_IFACE);
+  if (impl_config == NULL)
+    return;
+
+  impl = xdp_dbus_impl_scanner_proxy_new_sync (connection,
+                                               G_DBUS_PROXY_FLAGS_NONE,
+                                               impl_config->dbus_name,
+                                               DESKTOP_DBUS_PATH,
+                                               NULL,
+                                               &error);
+  if (impl == NULL)
+    {
+      g_warning ("Failed to create scanner proxy: %s", error->message);
+      return;
+    }
+
+  scanner = scanner_new (context, impl);
+
+  xdp_context_take_and_export_portal (context,
+                                      G_DBUS_INTERFACE_SKELETON (g_steal_pointer (&scanner)),
+                                      XDP_CONTEXT_EXPORT_FLAGS_NONE);
+}
