+/* Replies are written by the thread that serves requests and events by the one that scans, and a
+ * message must not be interleaved with another */
+static GMutex write_lock;
+
 static gboolean
 send_reply (guint32   serial,
             gboolean  ok,
             GVariant *result)
 {
   g_autoptr(GError) error = NULL;
+  gboolean written;
+
