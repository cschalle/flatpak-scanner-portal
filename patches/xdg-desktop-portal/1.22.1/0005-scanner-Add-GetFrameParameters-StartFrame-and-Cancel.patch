-  if (!scanner_protocol_write (SCANNER_HELPER_FD,
-                               g_variant_new ("(ubv)", serial, ok, result),
-                               &error))
+  if (!written)
     {
       g_printerr ("scanner-helper: %s\n", error->message);
       return FALSE;
@@ -583,14 +596,356 @@ handle_set_options (SANE_Handle   handle,
   return g_variant_new ("(@a{sv}@as)", g_variant_builder_end (&applied), g_variant_builder_end (&flags));
 }
 
+/* ---- Frames ----
+ *
+ * A frame is scanned by a thread of its own, so that the helper can go on reading requests (a
+ * Cancel, above all) while the scanner works. Only one thread talks to libsane at a time: the
+ * requests that need it are refused as busy while a frame is in progress. */
+
+typedef struct
+{
+  SANE_Handle handle;
+  gint busy;        /* a frame is in progress; atomic */
+  gint cancel;      /* the frame in progress is to stop; atomic */
+  guint32 frames;   /* number of the last frame started */
+  /* The last frame finished and was not the last of its scan, so the next one continues the scan:
+   * SANE wants sane_start again with no sane_cancel in between, since a real driver starts the
+   * scan over after a cancel. Only used while no frame is in progress, and by the frame's thread. */
+  gboolean mid_scan;
+  GThread *thread;
+} Session;
+
+typedef struct
+{
+  Session *session;
+  int out_fd;
+  guint32 frame;
+} FrameJob;
+
+/* sane.h keeps these out of its enumeration, "to be exposed in a later version of SANE", though
+ * backends for scanners with an infrared channel return them */
+#define FRAME_IR 0x0F
+#define FRAME_RGBI 0x10
+#define FRAME_GRAYI 0x11
+
+static const char *
+frame_format_name (SANE_Frame format)
+{
+  switch (format)
+    {
+    case SANE_FRAME_GRAY: return "gray";
+    case SANE_FRAME_RGB: return "rgb";
+    case SANE_FRAME_RED: return "red";
+    case SANE_FRAME_GREEN: return "green";
+    case SANE_FRAME_BLUE: return "blue";
+    default: break;
+    }
+
+  switch ((int) format)
+    {
+    case FRAME_IR: return "ir";
+    case FRAME_RGBI: return "rgbi";
+    case FRAME_GRAYI: return "grayi";
+    default: break;
+    }
+
+  return NULL;
+}
+
+static GVariant *
+frame_parameters_to_variant (const SANE_Parameters *params,
+                             const char            *format)
+{
+  GVariantBuilder builder;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&builder, "{sv}", "format", g_variant_new_string (format));
+  g_variant_builder_add (&builder, "{sv}", "depth", g_variant_new_uint32 (params->depth));
+  g_variant_builder_add (&builder, "{sv}", "pixels_per_line", g_variant_new_uint32 (params->pixels_per_line));
+  g_variant_builder_add (&builder, "{sv}", "bytes_per_line", g_variant_new_uint32 (params->bytes_per_line));
+  g_variant_builder_add (&builder, "{sv}", "lines", g_variant_new_int32 (params->lines));
+  g_variant_builder_add (&builder, "{sv}", "last_frame", g_variant_new_boolean (params->last_frame));
+
+  return g_variant_builder_end (&builder);
+}
+
+static const char *
+status_error_name (SANE_Status status)
+{
+  if (status == SANE_STATUS_ACCESS_DENIED)
+    return "org.freedesktop.portal.Error.NotAllowed";
+  if (status == SANE_STATUS_INVAL)
+    return "org.freedesktop.portal.Error.InvalidArgument";
+
+  return "org.freedesktop.portal.Error.Failed";
+}
+
+static void
+send_event (guint32      frame,
+            const char  *state,
+            GVariant    *details)
+{
+  GVariantBuilder builder;
+  GVariantIter iter;
+  GVariant *value;
+  const char *key;
+
+  /* Every event carries the number of its frame, so that a client can tell it from one left over
+   * from a frame it cancelled */
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&builder, "{sv}", "frame", g_variant_new_uint32 (frame));
+  if (details != NULL)
+    {
+      g_variant_iter_init (&iter, details);
+      while (g_variant_iter_next (&iter, "{&sv}", &key, &value))
+        {
+          g_variant_builder_add (&builder, "{sv}", key, value);
+          g_variant_unref (value);
+        }
+    }
+
+  send_reply (0, TRUE, g_variant_new ("(s@a{sv})", state, g_variant_builder_end (&builder)));
+
+  if (details != NULL)
+    g_variant_unref (g_variant_ref_sink (details));
+}
+
+/* Ends a frame. The pipe is closed first so that the application sees the end of the data, and the
+ * frame slot is freed before the event, so that the application can start the next frame from its
+ * handler for it. */
+static void
+finish_frame (FrameJob   *job,
+              const char *state,
+              GVariant   *details,
+              gboolean    more_frames)
+{
+  Session *session = job->session;
+
+  close (job->out_fd);
+  job->out_fd = -1;
+  session->mid_scan = more_frames;
+  g_atomic_int_set (&session->busy, 0);
+
+  send_event (job->frame, state, details);
+}
+
+static GVariant *
+error_details (SANE_Status  status,
+               const char  *message)
+{
+  GVariantBuilder builder;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&builder, "{sv}", "code", g_variant_new_string (status_error_name (status)));
+  g_variant_builder_add (&builder, "{sv}", "message", g_variant_new_string (message));
+
+  return g_variant_builder_end (&builder);
+}
+
+/* Writes it all to the pipe. Returns FALSE if the application closed its end or the frame was
+ * cancelled while the pipe was full. The pipe is not blocking, so that an application that is not
+ * reading cannot hold the thread past a Cancel.
+ *
+ * Writing to a pipe that has no reader raises SIGPIPE. Ignoring it for the process is not enough:
+ * backends change its disposition (the test backend sets it back to the default), so it is blocked
+ * for this thread while it writes, and a signal that came is taken off before it is unblocked. */
+static gboolean
+write_all_cancellable (Session       *session,
+                       int            fd,
+                       const guchar  *data,
+                       gsize          size)
+{
+  sigset_t pipe_set, old_set;
+  gboolean ok = TRUE;
+
+  sigemptyset (&pipe_set);
+  sigaddset (&pipe_set, SIGPIPE);
+  pthread_sigmask (SIG_BLOCK, &pipe_set, &old_set);
+
+  while (size > 0)
+    {
+      struct pollfd pfd = { .fd = fd, .events = POLLOUT };
+      ssize_t n = write (fd, data, size);
+
+      if (n > 0)
+        {
+          data += n;
+          size -= n;
+          continue;
+        }
+
+      if (n < 0 && errno == EINTR)
+        continue;
+
+      if (n < 0 && errno != EAGAIN)
+        {
+          if (errno == EPIPE)
+            {
+              struct timespec none = { 0, 0 };
+
+              while (sigtimedwait (&pipe_set, NULL, &none) < 0 && errno == EINTR)
+                ;
+            }
+          ok = FALSE;
+          break;
+        }
+
+      if (g_atomic_int_get (&session->cancel))
+        {
+          ok = FALSE;
+          break;
+        }
+
+      poll (&pfd, 1, 100);
+    }
+
+  pthread_sigmask (SIG_SETMASK, &old_set, NULL);
+
+  return ok;
+}
+
+static gpointer
+frame_thread (gpointer data)
+{
+  FrameJob *job = data;
+  Session *session = job->session;
+  SANE_Handle handle = session->handle;
+  SANE_Parameters params;
+  SANE_Status status;
+  const char *format;
+  g_autofree guchar *buffer = g_malloc (64 * 1024);
+  int flags;
+
+  /* A new scan: clear anything left over */
+  if (!session->mid_scan)
+    sane_cancel (handle);
+
+  status = sane_start (handle);
+  if (status != SANE_STATUS_GOOD)
+    {
+      if (status == SANE_STATUS_NO_DOCS)
+        finish_frame (job, "no-documents", NULL, FALSE);
+      else if (status == SANE_STATUS_CANCELLED)
+        finish_frame (job, "cancelled", NULL, FALSE);
+      else
+        finish_frame (job, "error", error_details (status, sane_strstatus (status)), FALSE);
+      goto out;
+    }
+
+  status = sane_get_parameters (handle, &params);
+  format = status == SANE_STATUS_GOOD ? frame_format_name (params.format) : NULL;
+  if (status != SANE_STATUS_GOOD || format == NULL)
+    {
+      sane_cancel (handle);
+      finish_frame (job, "error",
+                    error_details (status, status != SANE_STATUS_GOOD ? sane_strstatus (status)
+                                                                      : "The scanner's frame format is not supported"),
+                    FALSE);
+      goto out;
+    }
+
+  send_event (job->frame, "started", frame_parameters_to_variant (&params, format));
+
+  flags = fcntl (job->out_fd, F_GETFL);
+  if (flags >= 0)
+    fcntl (job->out_fd, F_SETFL, flags | O_NONBLOCK);
+
+  for (;;)
+    {
+      SANE_Int length = 0;
+
+      if (g_atomic_int_get (&session->cancel))
+        {
+          sane_cancel (handle);
+          finish_frame (job, "cancelled", NULL, FALSE);
+          break;
+        }
+
+      status = sane_read (handle, buffer, 64 * 1024, &length);
+
+      if ((status == SANE_STATUS_GOOD || status == SANE_STATUS_EOF) && length > 0 &&
+          !write_all_cancellable (session, job->out_fd, buffer, length))
+        {
+          sane_cancel (handle);
+          finish_frame (job, "cancelled", NULL, FALSE);
+          break;
+        }
+
+      if (status == SANE_STATUS_EOF)
+        {
+          if (params.last_frame)
+            sane_cancel (handle);
+          finish_frame (job, "finished", NULL, !params.last_frame);
+          break;
+        }
+
+      if (status == SANE_STATUS_CANCELLED)
+        {
+          finish_frame (job, "cancelled", NULL, FALSE);
+          break;
+        }
+
+      if (status != SANE_STATUS_GOOD)
+        {
+          sane_cancel (handle);
+          finish_frame (job, "error", error_details (status, sane_strstatus (status)), FALSE);
+          break;
+        }
+    }
+
+out:
+  g_free (job);
+  return NULL;
+}
+
+/* Starts a frame that writes to out_fd, which is taken over. Returns FALSE if one is in progress. */
+static gboolean
+start_frame (Session *session,
+             guint32  serial,
+             int      out_fd)
+{
+  FrameJob *job;
+
+  if (!g_atomic_int_compare_and_exchange (&session->busy, 0, 1))
+    return FALSE;
+
+  /* The one before has finished, so this does not wait */
+  if (session->thread != NULL)
+    g_thread_join (g_steal_pointer (&session->thread));
+
+  g_atomic_int_set (&session->cancel, 0);
+  job = g_new0 (FrameJob, 1);
+  job->session = session;
+  job->out_fd = out_fd;
+  job->frame = ++session->frames;
+
+  /* Reply before the thread can send an event, so that the application sees the reply first */
+  send_reply (serial, TRUE, g_variant_new_string (""));
+  session->thread = g_thread_new ("scanner-frame", frame_thread, job);
+
+  return TRUE;
+}
+
+static void
+stop_frame (Session *session)
+{
+  g_atomic_int_set (&session->cancel, 1);
+  if (session->thread != NULL)
+    g_thread_join (g_steal_pointer (&session->thread));
+}
+
 static int
 run_session (const char *name)
 {
+  Session session = { 0 };
   SANE_Handle handle = NULL;
   SANE_Status status;
   gboolean running = TRUE;
   int exit_code = 0;
 
+  /* An application that closes its end of the pipe is an error from write(), not a signal */
+  signal (SIGPIPE, SIG_IGN);
+
   status = sane_init (NULL, NULL);
   if (status != SANE_STATUS_GOOD)
     {
@@ -607,6 +962,8 @@ run_session (const char *name)
       return 1;
     }
 
+  session.handle = handle;
+
   if (!send_reply (0, TRUE, g_variant_new_string ("")))
     running = FALSE;
 
@@ -617,8 +974,11 @@ run_session (const char *name)
       g_autoptr(GVariant) args = NULL;
       const char *method;
       guint32 serial;
+      int pass_fd = -1;
+      gboolean busy;
 
-      request = scanner_protocol_read (SCANNER_HELPER_FD, G_VARIANT_TYPE ("(usv)"), -1, &error);
+      request = scanner_protocol_read_with_fd (SCANNER_HELPER_FD, G_VARIANT_TYPE ("(usv)"), -1,
+                                               &pass_fd, &error);
       if (request == NULL)
         {
           /* The portal closing the socket is how a session ends, so that is not an error */
@@ -631,12 +991,49 @@ run_session (const char *name)
         }
 
       g_variant_get (request, "(u&sv)", &serial, &method, &args);
+      busy = g_atomic_int_get (&session.busy) != 0;
 
       if (strcmp (method, "close") == 0)
         {
           send_reply (serial, TRUE, g_variant_new_string (""));
           running = FALSE;
         }
+      else if (strcmp (method, "cancel") == 0)
+        {
+          if (busy)
+            {
+              /* The frame's thread ends with a cancelled event */
+              g_atomic_int_set (&session.cancel, 1);
+            }
+          else
+            {
+              /* Between the frames of a scan this gives the scan up */
+              sane_cancel (handle);
+              session.mid_scan = FALSE;
+            }
+          send_reply (serial, TRUE, g_variant_new_string (""));
+        }
+      else if (strcmp (method, "start_frame") == 0)
+        {
+          if (pass_fd < 0)
+            {
+              send_failure (serial, "failed", "No pipe for the frame");
+            }
+          else if (start_frame (&session, serial, pass_fd))
+            {
+              /* The frame's thread has the descriptor now */
+              pass_fd = -1;
+            }
+          else
+            {
+              send_failure (serial, "busy", "A frame is in progress");
+            }
+        }
+      else if (busy)
+        {
+          /* The scanner is used by the frame's thread, and libsane is not called from two threads */
+          send_failure (serial, "busy", "A frame is in progress");
+        }
       else if (strcmp (method, "get_options") == 0)
         {
           send_reply (serial, TRUE, handle_get_options (handle));
@@ -645,6 +1042,19 @@ run_session (const char *name)
         {
           send_reply (serial, TRUE, handle_get_values (handle));
         }
+      else if (strcmp (method, "get_frame_parameters") == 0)
+        {
+          SANE_Parameters params;
+          SANE_Status params_status = sane_get_parameters (handle, &params);
+          const char *format = params_status == SANE_STATUS_GOOD ? frame_format_name (params.format) : NULL;
+
+          if (format != NULL)
+            send_reply (serial, TRUE, frame_parameters_to_variant (&params, format));
+          else
+            send_failure (serial, "failed",
+                          params_status != SANE_STATUS_GOOD ? sane_strstatus (params_status)
+                                                            : "The scanner's frame format is not supported");
+        }
       else if (strcmp (method, "set_options") == 0)
         {
           const char *kind = "invalid";
@@ -665,8 +1075,15 @@ run_session (const char *name)
         {
           send_failure (serial, "failed", "Unknown method");
         }
+
+      /* A descriptor that nothing took over */
+      if (pass_fd >= 0)
+        close (pass_fd);
     }
 
+  /* The frame's thread is the only one that may be using the scanner */
+  stop_frame (&session);
+
   sane_cancel (handle);
   sane_close (handle);
   sane_exit ();
diff --git a/src/scanner-protocol.h b/src/scanner-protocol.h
index cb76736..42687f5 100644
--- a/src/scanner-protocol.h
+++ b/src/scanner-protocol.h
@@ -6,9 +6,14 @@
  * file descriptor 3. A message is a GVariant, sent as its size in bytes (a 32-bit integer in
  * host byte order, both sides being on one machine) and then its serialized form.
  *
- * Requests, from the portal:  (usv)  serial, method, arguments
+ * Requests, from the portal:  (usv)  serial, method, arguments. The serial is 1 or more. A request
+ *                              can carry one file descriptor, passed with the message
+ *                              (SCM_RIGHTS): the write end of the pipe for a frame
  * Replies, from the helper:   (ubv)  serial, success, result; on failure the result is (ss), a kind,
- *                              "busy" or "failed", and a message
+ *                              "invalid", "busy" or "failed", and a message
+ * Events, from the helper:    (ubv)  with serial 0 once the session is open, success true and the
+ *                              result (sa{sv}), the state and details of a FrameEvent. They arrive
+ *                              at any time, between replies.
  *
  * The helper exits when the socket closes, after cancelling and closing the scanner.
  */
@@ -19,6 +24,7 @@
 #include <poll.h>
 #include <string.h>
 #include <sys/socket.h>
+#include <sys/uio.h>
 #include <unistd.h>
 
 #include <gio/gio.h>
@@ -33,6 +39,7 @@ scanner_protocol_read_exact (int       fd,
                              guchar   *buffer,
                              gsize     size,
                              int       timeout_ms,
+                             int      *received_fd,
                              GError  **error)
 {
   gsize done = 0;
@@ -56,7 +63,35 @@ scanner_protocol_read_exact (int       fd,
           return FALSE;
         }
 
-      n = read (fd, buffer + done, size - done);
+      {
+        struct iovec iov = { .iov_base = buffer + done, .iov_len = size - done };
+        union
+        {
+          struct cmsghdr align;
+          char buf[CMSG_SPACE (sizeof (int))];
+        } control;
+        struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1,
+                              .msg_control = control.buf, .msg_controllen = sizeof control.buf };
+        struct cmsghdr *cmsg;
+
+        n = recvmsg (fd, &msg, MSG_CMSG_CLOEXEC);
+
+        for (cmsg = n >= 0 ? CMSG_FIRSTHDR (&msg) : NULL; cmsg != NULL; cmsg = CMSG_NXTHDR (&msg, cmsg))
+          {
+            if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS &&
+                cmsg->cmsg_len == CMSG_LEN (sizeof (int)))
+              {
+                int passed;
