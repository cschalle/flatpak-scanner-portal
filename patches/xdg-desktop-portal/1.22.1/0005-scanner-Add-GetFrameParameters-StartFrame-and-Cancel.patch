+/* Sends a FrameEvent to the application that owns the session */
+static void
+scanner_session_emit_frame_event (XdpScannerSession *self,
+                                  const char        *state,
+                                  GVariant          *details)
+{
+  XdpSession *session = XDP_SESSION (self);
+  g_autoptr(GError) error = NULL;
+  gboolean stopping;
+
+  g_mutex_lock (&self->scanner->mutex);
+  stopping = self->stopping;
+  g_mutex_unlock (&self->scanner->mutex);
+
+  /* The application closed the session, or left, and is not waiting for events */
+  if (stopping)
+    return;
+
+  if (!g_dbus_connection_emit_signal (session->connection, session->sender, DESKTOP_DBUS_PATH,
+                                      "org.freedesktop.portal.Scanner", "FrameEvent",
+                                      g_variant_new ("(os@a{sv})", session->id, state, details),
+                                      &error))
+    g_warning ("[scanner] Failed to emit FrameEvent: %s", error->message);
+}
+
+/* Reads everything the helper sends: replies go to the call that is waiting for them, and events
+ * (which have serial 0) become FrameEvent signals. Ends when the socket does, which is when the
+ * session is closed or the helper has gone. */
+static gpointer
+scanner_session_reader (gpointer data)
+{
+  g_autoptr(XdpScannerSession) self = data;
+
+  for (;;)
+    {
+      g_autoptr(GVariant) message = NULL;
+      g_autoptr(GError) error = NULL;
+      g_autoptr(GVariant) result = NULL;
+      gboolean ok = FALSE;
+      guint32 serial;
+
+      message = scanner_protocol_read (self->fd, G_VARIANT_TYPE ("(ubv)"), -1, &error);
+      if (message == NULL)
+        {
+          if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CLOSED))
+            g_warning ("[scanner] Reading from the scanner helper: %s", error->message);
+          break;
+        }
+
+      g_variant_get (message, "(ub@v)", &serial, &ok, &result);
+
+      if (serial == 0)
+        {
+          g_autoptr(GVariant) event = g_variant_get_variant (result);
+
+          if (ok && g_variant_is_of_type (event, G_VARIANT_TYPE ("(sa{sv})")))
+            {
+              g_autoptr(GVariant) details = NULL;
+              const char *state;
+
+              g_variant_get (event, "(&s@a{sv})", &state, &details);
+              scanner_session_emit_frame_event (self, state, details);
+            }
+          continue;
