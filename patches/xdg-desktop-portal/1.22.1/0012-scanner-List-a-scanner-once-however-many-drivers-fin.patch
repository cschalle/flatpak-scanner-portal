diff --git a/src/scanner-devices.h b/src/scanner-devices.h
new file mode 100644
index 0000000..6a79868
--- /dev/null
+++ b/src/scanner-devices.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright © the xdg-desktop-portal contributors
+ */
+
+/* What the portal knows about scanners that SANE does not say. SANE's device type is whatever
+ * the driver puts there: the Plustek OpticFilm 8200i is a "film scanner" to one driver and a
+ * flatbed to another, and a network scanner's type is its address. The portal gives
+ * applications capabilities they can filter on, so that a film application and a document
+ * application can each be offered the scanners they are for.
+ *
+ * A scanner is matched by its USB id, which is exact, or by a part of its vendor and model, which
+ * covers a product line. Film scanners are few, so naming them is feasible; a scanner that is not
+ * named here and is not film by its type is assumed to be for documents.
+ *
+ * The capabilities are separated by semicolons: film, infrared, flatbed, adf, color. A flatbed with
+ * a transparency unit has both film and flatbed.
+ */
+
+#pragma once
+
+typedef struct
+{
+  const char *usb_id;          /* "07b3:1825", lower case, or NULL */
+  const char *model_contains;  /* lower case part of "vendor model", or NULL */
+  const char *name;            /* a clean name to show, or NULL to keep the driver's */
+  const char *capabilities;
+} ScannerKnown;
+
+static const ScannerKnown scanner_known[] = {
+  /* By USB id */
+  { "07b3:1825", NULL, "Plustek OpticFilm 8200i SE", "film;infrared;color" },
+
+  /* Dedicated film scanners, by product line */
+  { NULL, "opticfilm", NULL, "film;color" },
+  { NULL, "coolscan", NULL, "film;color" },
+  { NULL, "dimage scan", NULL, "film;color" },
+  { NULL, "scan elite", NULL, "film;color" },
+  { NULL, "filmscan", NULL, "film;color" },
+  { NULL, "primefilm", NULL, "film;color" },
+  { NULL, "film scanner", NULL, "film;color" },
+  { NULL, "slide scanner", NULL, "film;color" },
+
+  /* Flatbeds with a transparency unit: for documents and for film */
+  { NULL, "perfection v370", NULL, "flatbed;film;color" },
+  { NULL, "perfection v500", NULL, "flatbed;film;color" },
+  { NULL, "perfection v550", NULL, "flatbed;film;color" },
+  { NULL, "perfection v600", NULL, "flatbed;film;color" },
+  { NULL, "perfection v700", NULL, "flatbed;film;color" },
+  { NULL, "perfection v750", NULL, "flatbed;film;color" },
+  { NULL, "perfection v800", NULL, "flatbed;film;color" },
+  { NULL, "perfection v850", NULL, "flatbed;film;color" },
+};
+
+/* How a driver ranks for a scanner that more than one driver found: the lower the better. The
+ * drivers that speak a standard protocol to a network scanner work on more scanners and firmware
+ * than the vendor's. Drivers not named here rank in the middle, and a driver that goes through
+ * another host comes last. */
+typedef struct
+{
+  const char *backend;
+  int rank;
+} ScannerBackendRank;
+
+#define SCANNER_DEFAULT_RANK 2
+
+static const ScannerBackendRank scanner_backend_ranks[] = {
+  { "airscan", 0 },
+  { "escl", 1 },
+  { "hpaio", 8 },
+  { "net", 9 },
+};
diff --git a/src/scanner-helper.c b/src/scanner-helper.c
index 9e9c52b..816ea55 100644
--- a/src/scanner-helper.c
+++ b/src/scanner-helper.c
@@ -69,6 +69,99 @@ scanner_capabilities (const char *type)
   return (const char **) g_ptr_array_free (caps, FALSE);
 }
 
+/* A number from a file in a sysfs directory, or -1 */
+static int
+sysfs_int (const char *dir,
+           const char *file)
+{
+  g_autofree char *path = g_build_filename (dir, file, NULL);
+  g_autofree char *contents = NULL;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return -1;
+
+  return (int) g_ascii_strtoll (g_strstrip (contents), NULL, 10);
+}
+
+/* The vendor and product id ("07b3:1825") of the USB device at a bus and device number, or NULL */
+static char *
+usb_id_for_address (int bus,
+                    int address)
+{
+  g_autoptr(GDir) dir = g_dir_open ("/sys/bus/usb/devices", 0, NULL);
+  const char *entry;
+
+  while (dir != NULL && (entry = g_dir_read_name (dir)) != NULL)
+    {
+      g_autofree char *base = g_build_filename ("/sys/bus/usb/devices", entry, NULL);
+      g_autofree char *vendor = NULL;
+      g_autofree char *product = NULL;
+      g_autofree char *vendor_path = NULL;
+      g_autofree char *product_path = NULL;
+
+      if (sysfs_int (base, "busnum") != bus || sysfs_int (base, "devnum") != address)
+        continue;
+
+      vendor_path = g_build_filename (base, "idVendor", NULL);
+      product_path = g_build_filename (base, "idProduct", NULL);
+      if (g_file_get_contents (vendor_path, &vendor, NULL, NULL) &&
+          g_file_get_contents (product_path, &product, NULL, NULL))
+        return g_strdup_printf ("%s:%s", g_strstrip (vendor), g_strstrip (product));
+    }
+
+  return NULL;
+}
+
+/* The host of a network scanner, from the address in its name or type: `ip=192.0.2.1` (HPLIP,
+ * airscan) or a URL (eSCL). Drivers that reach a scanner through another host, such as SANE's net
+ * backend, are not matched, since that host may have several. */
+static char *
+network_host (const SANE_Device *device)
+{
+  const char *name = device->name;
+  const char *type = device->type ? device->type : "";
+  const char *start = NULL;
+  gsize len;
+
+  if (g_str_has_prefix (name, "net:"))
+    return NULL;
+
+  if ((start = strstr (name, "ip=")) != NULL)
+    start += 3;
+  else if (g_str_has_prefix (type, "ip="))
+    start = type + 3;
+  else if ((start = strstr (name, "://")) != NULL)
+    start += 3;
+  if (start == NULL)
+    return NULL;
+
+  len = strcspn (start, "&:/?, ");
+  return len > 0 ? g_strndup (start, len) : NULL;
+}
+
+/* Which physical scanner this is, so that the portal can tell that two drivers have found the
+ * same one: the USB bus and device number, or the host of a network scanner. NULL if unknown. */
+static char *
+scanner_physical (const SANE_Device *device,
+                  char             **usb_id)
+{
+  const char *usb = strstr (device->name, "libusb:");
+  g_autofree char *host = NULL;
+  int bus;
+  int address;
+
+  *usb_id = NULL;
+
+  if (usb != NULL && sscanf (usb, "libusb:%d:%d", &bus, &address) == 2)
+    {
+      *usb_id = usb_id_for_address (bus, address);
+      return g_strdup_printf ("usb:%d:%d", bus, address);
+    }
+
+  host = network_host (device);
+  return host != NULL ? g_strdup_printf ("net:%s", host) : NULL;
+}
+
 /* Webcams come through SANE's v4l backend and cannot scan anything a user would call a scan */
 static gboolean
 is_webcam (const SANE_Device *device)
@@ -85,6 +178,8 @@ scanner_to_variant (const SANE_Device *device)
   g_autofree char *name = NULL;
   g_autofree char *backend = NULL;
   g_autofree const char **caps = scanner_capabilities (device->type);
+  g_autofree char *usb_id = NULL;
+  g_autofree char *physical = scanner_physical (device, &usb_id);
   const char *colon = strchr (device->name, ':');
   GVariantBuilder info;
 
@@ -104,6 +199,11 @@ scanner_to_variant (const SANE_Device *device)
                          g_variant_new_string (device->type ? device->type : ""));
   g_variant_builder_add (&info, "{sv}", "capabilities", g_variant_new_strv (caps, -1));
   g_variant_builder_add (&info, "{sv}", "available", g_variant_new_boolean (TRUE));
+  /* For the portal's own use: it takes these out before an application sees the scanner */
+  if (physical != NULL)
+    g_variant_builder_add (&info, "{sv}", "physical", g_variant_new_string (physical));
+  if (usb_id != NULL)
+    g_variant_builder_add (&info, "{sv}", "usb_id", g_variant_new_string (usb_id));
 
   return g_variant_new ("(ss@a{sv})", id, device->name, g_variant_builder_end (&info));
 }
