+/* One scanner for each physical scanner. The drivers that found it are kept, best first, in the
+ * scanner that stays, and OpenScanner tries them in that order, so that a driver that cannot open
+ * the scanner, such as HPLIP's for a network printer that only speaks eSCL, is not the end of it.
+ * Takes the list and returns the new one; scanners that are not known to be the same stay. */
+static GPtrArray *
+scanner_merge_duplicates (GPtrArray *devices)
+{
+  GPtrArray *merged = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_device_free);
+  g_autoptr(GHashTable) groups = g_hash_table_new (g_str_hash, g_str_equal);
+  gsize n = 0;
+  gpointer *items = g_ptr_array_steal (devices, &n);
+
+  g_ptr_array_unref (devices);
+
+  for (gsize i = 0; i < n; i++)
+    {
+      ScannerDevice *device = items[i];
+      ScannerDevice *first = device->physical != NULL ? g_hash_table_lookup (groups, device->physical) : NULL;
+
+      if (first == NULL)
+        {
+          g_ptr_array_add (merged, device);
+          if (device->physical != NULL)
+            g_hash_table_insert (groups, device->physical, device);
+          continue;
+        }
+
+      /* The same scanner found by another driver: keep its names, in the order of the drivers
+       * and, among equals, of the search */
+      for (guint k = 0; k < device->candidates->len; k++)
+        {
+          ScannerCandidate *candidate = g_ptr_array_index (device->candidates, k);
+          guint at = first->candidates->len;
+
+          while (at > 0 && ((ScannerCandidate *) g_ptr_array_index (first->candidates, at - 1))->rank > candidate->rank)
+            at--;
+          g_ptr_array_insert (first->candidates, at, candidate);
+        }
+      g_free (g_ptr_array_steal (device->candidates, NULL));   /* the names moved, they are not freed */
+      g_free (first->sane_name);
+      first->sane_name = g_strdup (((ScannerCandidate *) g_ptr_array_index (first->candidates, 0))->name);
+      first->rank = ((ScannerCandidate *) g_ptr_array_index (first->candidates, 0))->rank;
+      scanner_device_free (device);
+    }
+  g_free (items);
+
+  return merged;
+}
+
 static ScannerDevice *
 scanner_device_new (const char *id,
                     const char *name,
@@ -653,7 +817,7 @@ scanner_enumerate_with_helper (void)
   GPtrArray *all;
 
   scanner_discover (collect_batch, &collected, NULL);
-  all = scanner_flatten (&collected);
+  all = scanner_merge_duplicates (scanner_flatten (&collected));
   g_clear_pointer (&collected.slots, g_ptr_array_unref);
 
   return all;
@@ -723,6 +887,23 @@ scanner_device_has_capabilities (ScannerDevice       *device,
   return TRUE;
 }
 
+/* TRUE if there is nothing asked for, or the scanner has at least one of the capabilities */
+static gboolean
+scanner_device_has_any_capability (ScannerDevice       *device,
+                                   const char * const  *any)
+{
+  if (any == NULL || any[0] == NULL)
+    return TRUE;
+
+  for (size_t i = 0; any[i]; i++)
+    {
+      if (g_strv_contains ((const char * const *) device->capabilities, any[i]))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
