   gboolean multiple;
   GHashTable *candidates; /* id → GVariant (s, a{sv}) */
-  GStrv required;         /* the capabilities asked for */
+  GStrv required;         /* the capabilities asked for: a scanner has all of them */
+  GStrv any;              /* the capabilities asked for: a scanner has at least one of them */
   GCancellable *cancellable; /* ends the search for scanners, which may outlive the call */
   gboolean finished;      /* the backend has answered, nothing more is offered */
 } SelectData;
@@ -808,6 +990,7 @@ select_data_free (SelectData *data)
   g_clear_object (&data->cancellable);
   g_clear_pointer (&data->candidates, g_hash_table_unref);
   g_strfreev (data->required);
+  g_strfreev (data->any);
   g_free (data);
 }
 
@@ -917,6 +1100,7 @@ typedef struct
   GCancellable *cancellable;
   GPtrArray *slots;       /* per backend: the ScannerDevice it found, NULL until it answers */
   GPtrArray *before;      /* what came before the hand-over, in the order of the drivers */
+  GHashTable *seen;       /* the ids the dialog has been offered: a scanner found by two drivers is offered once */
   gboolean handed_over;
