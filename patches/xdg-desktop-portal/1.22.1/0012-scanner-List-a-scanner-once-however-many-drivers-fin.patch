   g_clear_pointer (&device->info, g_variant_unref);
   g_strfreev (device->capabilities);
   g_free (device);
@@ -133,32 +153,176 @@ scanner_device_free (ScannerDevice *device)
 
 G_DEFINE_AUTOPTR_CLEANUP_FUNC (ScannerDevice, scanner_device_free)
 
-/* From one entry of the helper's list: an id, the SANE name and the information vardict */
+static const ScannerKnown *
+scanner_known_lookup (const char *usb_id,
+                      const char *vendor,
+                      const char *model)
+{
+  g_autofree char *joined = g_strdup_printf ("%s %s", vendor ? vendor : "", model ? model : "");
+  g_autofree char *full = g_ascii_strdown (joined, -1);
+
+  for (size_t i = 0; i < G_N_ELEMENTS (scanner_known); i++)
+    {
+      if (scanner_known[i].usb_id != NULL && usb_id != NULL &&
+          g_ascii_strcasecmp (scanner_known[i].usb_id, usb_id) == 0)
+        return &scanner_known[i];
+    }
+
+  for (size_t i = 0; i < G_N_ELEMENTS (scanner_known); i++)
+    {
+      if (scanner_known[i].model_contains != NULL &&
+          strstr (full, scanner_known[i].model_contains) != NULL)
+        return &scanner_known[i];
+    }
+
+  return NULL;
+}
+
+static int
+scanner_backend_rank (const char *backend)
+{
+  for (size_t i = 0; backend != NULL && i < G_N_ELEMENTS (scanner_backend_ranks); i++)
+    {
+      if (g_strcmp0 (scanner_backend_ranks[i].backend, backend) == 0)
+        return scanner_backend_ranks[i].rank;
+    }
+
+  return SCANNER_DEFAULT_RANK;
+}
+
+/* From one entry of the helper's list: an id, the SANE name and the information vardict. What the
+ * portal knows about the scanner is added: its capabilities, and an id that is the same for every
+ * driver that finds it, so that they are one scanner to the dialog and to applications. */
 static ScannerDevice *
 scanner_device_new_from_helper (const char *id,
                                 const char *sane_name,
                                 GVariant   *info)
 {
   ScannerDevice *device = g_new0 (ScannerDevice, 1);
-  const char **caps = NULL;
-
-  device->id = g_strdup (id);
+  g_auto(GVariantDict) dict = G_VARIANT_DICT_INIT (info);
+  g_autoptr(GPtrArray) caps = g_ptr_array_new_with_free_func (g_free);
+  const ScannerKnown *known;
+  const char *physical = NULL;
+  const char *usb_id = NULL;
+  const char *vendor = NULL;
+  const char *model = NULL;
+  const char *backend = NULL;
+  const char **hints = NULL;
+
