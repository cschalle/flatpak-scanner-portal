+  g_variant_dict_lookup (&dict, "usb_id", "&s", &usb_id);
+  g_variant_dict_lookup (&dict, "vendor", "&s", &vendor);
+  g_variant_dict_lookup (&dict, "model", "&s", &model);
+  g_variant_dict_lookup (&dict, "backend", "&s", &backend);
+
+  known = scanner_known_lookup (usb_id, vendor, model);
+  if (known != NULL)
