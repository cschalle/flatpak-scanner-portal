index 28cbd49..a50061f 100644
--- a/src/scanner-helper.c
+++ b/src/scanner-helper.c
@@ -9,6 +9,11 @@
  *     Asks libsane for the scanners and writes them to stdout as a serialized GVariant of type
  *     a(ssa{sv}): an opaque id, the SANE device name, and the information the portal gives to
  *     applications. The SANE name stays inside the portal; applications only get the id.
+ *
+ * xdg-desktop-portal-scanner-helper session NAME
+ *     Opens the scanner NAME and serves requests from the portal on file descriptor 3, as
+ *     described in scanner-protocol.h, until the portal closes it. The first reply says whether
+ *     the scanner could be opened.
  */
 
 #include <stdio.h>
@@ -18,6 +23,8 @@
 #include <glib.h>
 #include <sane/sane.h>
 
+#include "scanner-protocol.h"
+
 /* A stable token for a SANE device name. Not security relevant, only opaque to applications. */
 static char *
 scanner_id_for_name (const char *name)
@@ -143,12 +150,107 @@ run_list (void)
   return 0;
 }
 
+static gboolean
+send_reply (guint32   serial,
+            gboolean  ok,
+            GVariant *result)
+{
+  g_autoptr(GError) error = NULL;
+
+  if (!scanner_protocol_write (SCANNER_HELPER_FD,
+                               g_variant_new ("(ubv)", serial, ok, result),
+                               &error))
+    {
+      g_printerr ("scanner-helper: %s\n", error->message);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+send_failure (guint32      serial,
+              const char  *kind,
+              const char  *message)
+{
+  return send_reply (serial, FALSE, g_variant_new ("(ss)", kind, message));
+}
+
+static int
+run_session (const char *name)
+{
+  SANE_Handle handle = NULL;
+  SANE_Status status;
+  gboolean running = TRUE;
+  int exit_code = 0;
+
+  status = sane_init (NULL, NULL);
+  if (status != SANE_STATUS_GOOD)
+    {
+      send_failure (0, "failed", sane_strstatus (status));
+      return 1;
+    }
+
+  status = sane_open (name, &handle);
+  if (status != SANE_STATUS_GOOD)
+    {
+      send_failure (0, status == SANE_STATUS_DEVICE_BUSY ? "busy" : "failed",
+                    sane_strstatus (status));
+      sane_exit ();
+      return 1;
+    }
+
+  if (!send_reply (0, TRUE, g_variant_new_string ("")))
+    running = FALSE;
+
+  while (running)
+    {
+      g_autoptr(GVariant) request = NULL;
+      g_autoptr(GError) error = NULL;
+      const char *method;
+      guint32 serial;
+
+      request = scanner_protocol_read (SCANNER_HELPER_FD, G_VARIANT_TYPE ("(usv)"), -1, &error);
+      if (request == NULL)
+        {
+          /* The portal closing the socket is how a session ends, so that is not an error */
+          if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CLOSED))
+            {
+              g_printerr ("scanner-helper: %s\n", error->message);
+              exit_code = 1;
+            }
+          break;
+        }
+
+      g_variant_get (request, "(u&sv)", &serial, &method, NULL);
+
+      if (strcmp (method, "close") == 0)
+        {
+          send_reply (serial, TRUE, g_variant_new_string (""));
+          running = FALSE;
+        }
+      else
+        {
+          send_failure (serial, "failed", "Unknown method");
+        }
+    }
+
+  sane_cancel (handle);
+  sane_close (handle);
+  sane_exit ();
+
+  return exit_code;
+}
+
 int
 main (int argc, char *argv[])
 {
   if (argc == 2 && strcmp (argv[1], "list") == 0)
     return run_list ();
 
-  g_printerr ("usage: %s list\n", argv[0]);
+  if (argc == 3 && strcmp (argv[1], "session") == 0)
+    return run_session (argv[2]);
+
+  g_printerr ("usage: %s list | session NAME\n", argv[0]);
   return 2;
 }
diff --git a/src/scanner-protocol.h b/src/scanner-protocol.h
new file mode 100644
index 0000000..cb76736
--- /dev/null
+++ b/src/scanner-protocol.h
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright © the xdg-desktop-portal contributors
+ */
+
+/* How the portal and its scanner helper talk over the socket the portal passes to the helper as
+ * file descriptor 3. A message is a GVariant, sent as its size in bytes (a 32-bit integer in
+ * host byte order, both sides being on one machine) and then its serialized form.
+ *
+ * Requests, from the portal:  (usv)  serial, method, arguments
+ * Replies, from the helper:   (ubv)  serial, success, result; on failure the result is (ss), a kind,
+ *                              "busy" or "failed", and a message
+ *
+ * The helper exits when the socket closes, after cancelling and closing the scanner.
+ */
+
+#pragma once
+
+#include <errno.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <gio/gio.h>
+
+#define SCANNER_HELPER_FD 3
+#define SCANNER_PROTOCOL_MAX_MESSAGE (16 * 1024 * 1024)
+
+/* Reads exactly size bytes. Returns FALSE with G_IO_ERROR_CLOSED on end of file, and with
+ * G_IO_ERROR_TIMED_OUT when nothing arrived within timeout_ms (negative waits for ever). */
+static inline gboolean
+scanner_protocol_read_exact (int       fd,
+                             guchar   *buffer,
+                             gsize     size,
+                             int       timeout_ms,
+                             GError  **error)
+{
+  gsize done = 0;
+
+  while (done < size)
+    {
+      struct pollfd pfd = { .fd = fd, .events = POLLIN };
+      ssize_t n;
+      int r = poll (&pfd, 1, timeout_ms);
+
+      if (r < 0 && errno == EINTR)
+        continue;
+      if (r < 0)
+        {
+          g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "poll: %s", g_strerror (errno));
+          return FALSE;
+        }
+      if (r == 0)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT, "Timed out");
+          return FALSE;
+        }
+
+      n = read (fd, buffer + done, size - done);
+      if (n < 0 && errno == EINTR)
+        continue;
+      if (n < 0)
+        {
+          g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "read: %s", g_strerror (errno));
+          return FALSE;
+        }
+      if (n == 0)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_CLOSED, "Closed");
+          return FALSE;
+        }
+      done += n;
+    }
+
+  return TRUE;
+}
+
+/* Reads one message and returns it, checked to be of the given type and in normal form, or NULL
+ * with an error set. */
+static inline GVariant *
+scanner_protocol_read (int                  fd,
+                       const GVariantType  *type,
+                       int                  timeout_ms,
+                       GError             **error)
+{
+  guint32 size;
+  g_autofree guchar *data = NULL;
+  g_autoptr(GBytes) bytes = NULL;
+  g_autoptr(GVariant) message = NULL;
+
+  if (!scanner_protocol_read_exact (fd, (guchar *) &size, sizeof size, timeout_ms, error))
+    return NULL;
+
+  if (size == 0 || size > SCANNER_PROTOCOL_MAX_MESSAGE)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Bad message size %u", size);
+      return NULL;
+    }
+
+  data = g_malloc (size);
+  if (!scanner_protocol_read_exact (fd, data, size, timeout_ms, error))
+    return NULL;
+
+  bytes = g_bytes_new_take (g_steal_pointer (&data), size);
+  message = g_variant_ref_sink (g_variant_new_from_bytes (type, bytes, FALSE));
+  if (!g_variant_is_normal_form (message))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, "Malformed message");
+      return NULL;
+    }
+
+  return g_steal_pointer (&message);
+}
+
+static inline gboolean
+scanner_protocol_write (int        fd,
+                        GVariant  *message,
+                        GError   **error)
+{
+  g_autoptr(GVariant) normal = g_variant_get_normal_form (message);
+  guint32 size = g_variant_get_size (normal);
+  const guchar *data = g_variant_get_data (normal);
+  g_autofree guchar *buffer = g_malloc (sizeof size + size);
+  gsize done = 0;
+
+  memcpy (buffer, &size, sizeof size);
+  memcpy (buffer + sizeof size, data, size);
+
+  while (done < sizeof size + size)
+    {
+      /* send(), not write(), so that a helper that has gone away is an error, not a SIGPIPE that
+       * would take the portal with it */
+      ssize_t n = send (fd, buffer + done, sizeof size + size - done, MSG_NOSIGNAL);
+
+      if (n < 0 && errno == EINTR)
+        continue;
+      if (n < 0)
+        {
+          g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "send: %s", g_strerror (errno));
+          return FALSE;
+        }
+      done += n;
+    }
+
+  return TRUE;
+}
diff --git a/src/scanner.c b/src/scanner.c
index 471b1c6..02dab39 100644
--- a/src/scanner.c
