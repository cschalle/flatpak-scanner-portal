 #include <gio/gio.h>
+#include <gio/gunixfdlist.h>
 
 #include "xdp-context.h"
 #include "xdp-dbus.h"
 #include "xdp-impl-dbus.h"
 #include "xdp-portal-config.h"
+#include "scanner-protocol.h"
 #include "xdp-request.h"
+#include "xdp-session.h"
 #include "xdp-utils.h"
 
 /* Scanners are listed by id, and an application only ever sees the ones the user chose for it.
@@ -28,6 +34,10 @@ struct _XdpScanner
   XdpDbusImplScanner *impl;
 
   GMutex mutex;
+
+  /* The scanners that are open, by id. This is the host's exclusive lock: one application at a
+   * time has a scanner. The sessions are not owned; a session removes itself when it closes. */
+  GHashTable *open_scanners;
 };
 
 #define XDP_TYPE_SCANNER (xdp_scanner_get_type ())
@@ -38,6 +48,24 @@ static void xdp_scanner_iface_init (XdpDbusScannerIface *iface);
 G_DEFINE_FINAL_TYPE_WITH_CODE (XdpScanner, xdp_scanner, XDP_DBUS_TYPE_SCANNER_SKELETON,
                                G_IMPLEMENT_INTERFACE (XDP_DBUS_TYPE_SCANNER, xdp_scanner_iface_init));
 
+struct _XdpScannerSession
+{
+  XdpSession parent;
+
+  XdpScanner *scanner;
+  char *scanner_id;
+
+  /* The helper that holds the scanner open, and our end of the socket we talk to it over */
+  GSubprocess *helper;
+  int fd;
+  gboolean stopping;
+};
+
+#define XDP_TYPE_SCANNER_SESSION (xdp_scanner_session_get_type ())
+G_DECLARE_FINAL_TYPE (XdpScannerSession, xdp_scanner_session, XDP, SCANNER_SESSION, XdpSession);
+
+G_DEFINE_FINAL_TYPE (XdpScannerSession, xdp_scanner_session, xdp_session_get_type ())
+
 #define GRANTS_KEY "-xdp-scanner-grants"
 
 /* The scanners the user has chosen for one application: a set of ids */
@@ -538,11 +566,357 @@ handle_select_scanners (XdpDbusScanner         *object,
   return G_DBUS_METHOD_INVOCATION_HANDLED;
 }
 
+/* ---- Sessions: an open scanner ---- */
+
+#define HELPER_OPEN_TIMEOUT_MS 60000
+#define HELPER_EXIT_GRACE_SECONDS 5
+
+static gboolean
+helper_force_exit_cb (gpointer data)
+{
+  GSubprocess *helper = data;
+
+  /* The helper exits by itself when its socket closes; this is for one that does not */
+  if (!g_subprocess_get_if_exited (helper))
+    {
+      g_warning ("[scanner] The scanner helper did not exit, killing it");
+      g_subprocess_force_exit (helper);
+    }
+
+  g_object_unref (helper);
+
+  return G_SOURCE_REMOVE;
+}
+
+/* Closes the socket, which makes the helper cancel and close the scanner and exit, and makes
+ * sure it does. Called with the scanner mutex held. */
+static void
+scanner_session_stop_helper (XdpScannerSession *self)
+{
+  self->stopping = TRUE;
+
+  if (self->fd >= 0)
+    {
+      close (self->fd);
+      self->fd = -1;
+    }
+
+  if (self->helper != NULL)
+    {
+      g_timeout_add_seconds (HELPER_EXIT_GRACE_SECONDS, helper_force_exit_cb,
+                             g_object_ref (self->helper));
+      g_clear_object (&self->helper);
+    }
+}
+
+static void
+scanner_session_release_lock (XdpScannerSession *self)
+{
+  if (g_hash_table_lookup (self->scanner->open_scanners, self->scanner_id) == self)
+    g_hash_table_remove (self->scanner->open_scanners, self->scanner_id);
+}
+
+static void
+xdp_scanner_session_close (XdpSession *session)
+{
+  XdpScannerSession *self = XDP_SCANNER_SESSION (session);
+  XdpScanner *scanner = self->scanner;
+
+  g_debug ("[scanner] Session '%s' closed", session->id);
+
+  g_mutex_lock (&scanner->mutex);
+  scanner_session_stop_helper (self);
+  scanner_session_release_lock (self);
+  g_mutex_unlock (&scanner->mutex);
+}
+
+static void
+xdp_scanner_session_dispose (GObject *object)
+{
+  XdpScannerSession *self = XDP_SCANNER_SESSION (object);
+
+  if (self->scanner != NULL)
+    {
+      g_mutex_lock (&self->scanner->mutex);
+      scanner_session_stop_helper (self);
+      scanner_session_release_lock (self);
+      g_mutex_unlock (&self->scanner->mutex);
+    }
+
+  g_clear_object (&self->scanner);
+  g_clear_pointer (&self->scanner_id, g_free);
+
+  G_OBJECT_CLASS (xdp_scanner_session_parent_class)->dispose (object);
+}
+
+static void
+xdp_scanner_session_class_init (XdpScannerSessionClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  XdpSessionClass *session_class = (XdpSessionClass *) klass;
+
+  object_class->dispose = xdp_scanner_session_dispose;
+  session_class->close = xdp_scanner_session_close;
+}
+
+static void
+xdp_scanner_session_init (XdpScannerSession *self)
+{
+  self->fd = -1;
+}
+
+static XdpScannerSession *
+xdp_scanner_session_new (XdpScanner       *scanner,
+                         GDBusConnection  *connection,
+                         const char       *sender,
+                         XdpAppInfo       *app_info,
+                         const char       *scanner_id,
+                         const char       *token,
+                         GError          **error)
+{
+  XdpSession *session;
+  XdpScannerSession *scanner_session;
+
+  session = g_initable_new (XDP_TYPE_SCANNER_SESSION,
+                            NULL, error,
+                            "context", scanner->context,
+                            "sender", sender,
+                            "app-id", xdp_app_info_get_id (app_info),
+                            "connection", connection,
+                            "token", token,
+                            NULL);
+  if (session == NULL)
+    return NULL;
+
+  scanner_session = XDP_SCANNER_SESSION (session);
+  scanner_session->scanner = g_object_ref (scanner);
+  scanner_session->scanner_id = g_strdup (scanner_id);
+
+  return scanner_session;
+}
+
+/* The helper went away. If the session did not ask for that, tell the application. */
+static void
+helper_exited_cb (GObject      *source_object,
+                  GAsyncResult *result,
+                  gpointer      user_data)
+{
+  g_autoptr(XdpScannerSession) self = user_data;
+  gboolean stopping;
+
+  g_subprocess_wait_finish (G_SUBPROCESS (source_object), result, NULL);
+
+  g_mutex_lock (&self->scanner->mutex);
+  stopping = self->stopping;
+  g_mutex_unlock (&self->scanner->mutex);
+
+  if (!stopping)
+    {
+      g_warning ("[scanner] The scanner helper for session '%s' exited, closing the session",
+                 XDP_SESSION (self)->id);
+      xdp_session_close (XDP_SESSION (self), TRUE);
+    }
+}
+
+/* Starts the helper for one scanner and waits for it to say whether it opened. The scanner
+ * mutex is not held, since opening can take a while. */
+static gboolean
+scanner_session_open (XdpScannerSession  *self,
+                      const char         *sane_name,
+                      GError            **error)
+{
+  g_autoptr(GSubprocessLauncher) launcher = NULL;
+  g_autoptr(GSubprocess) helper = NULL;
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GVariant) result = NULL;
+  const char *helper_path = g_getenv ("XDP_SCANNER_HELPER");
+  const char *kind = NULL;
+  const char *message = NULL;
+  gboolean ok = FALSE;
+  guint32 serial;
+  int fds[2];
+
+  if (helper_path == NULL)
+    helper_path = LIBEXECDIR "/xdg-desktop-portal-scanner-helper";
+
+  if (socketpair (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, fds) < 0)
+    {
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR, XDG_DESKTOP_PORTAL_ERROR_FAILED,
+                   "Failed to create a socket: %s", g_strerror (errno));
+      return FALSE;
+    }
+
+  launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_NONE);
+  g_subprocess_launcher_take_fd (launcher, fds[1], SCANNER_HELPER_FD);
+
+  helper = g_subprocess_launcher_spawn (launcher, error, helper_path, "session", sane_name, NULL);
+  if (helper == NULL)
+    {
+      close (fds[0]);
+      return FALSE;
+    }
+
+  reply = scanner_protocol_read (fds[0], G_VARIANT_TYPE ("(ubv)"), HELPER_OPEN_TIMEOUT_MS, error);
+  if (reply == NULL)
+    {
+      g_prefix_error (error, "The scanner helper did not answer: ");
+      g_subprocess_force_exit (helper);
+      close (fds[0]);
+      return FALSE;
+    }
+
+  g_variant_get (reply, "(ub@v)", &serial, &ok, &result);
+  if (!ok)
+    {
+      g_autoptr(GVariant) inner = g_variant_get_variant (result);
+
+      if (g_variant_is_of_type (inner, G_VARIANT_TYPE ("(ss)")))
+        g_variant_get (inner, "(&s&s)", &kind, &message);
+
+      g_set_error (error, XDG_DESKTOP_PORTAL_ERROR,
+                   g_strcmp0 (kind, "busy") == 0 ? XDG_DESKTOP_PORTAL_ERROR_BUSY
+                                                  : XDG_DESKTOP_PORTAL_ERROR_FAILED,
+                   "Could not open the scanner: %s", message ? message : "unknown error");
+      g_subprocess_force_exit (helper);
+      close (fds[0]);
+      return FALSE;
+    }
+
+  g_mutex_lock (&self->scanner->mutex);
+  self->fd = fds[0];
+  self->helper = g_object_ref (helper);
+  g_mutex_unlock (&self->scanner->mutex);
+
+  g_subprocess_wait_async (helper, NULL, helper_exited_cb, g_object_ref (self));
+
+  return TRUE;
+}
+
+static gboolean
+handle_open_scanner (XdpDbusScanner         *object,
+                     GDBusMethodInvocation  *invocation,
+                     const char             *arg_scanner_id,
+                     GVariant               *arg_options)
+{
+  XdpScanner *self = XDP_SCANNER (object);
+  XdpAppInfo *app_info = xdp_invocation_get_app_info (invocation);
+  g_autoptr(GPtrArray) devices = NULL;
+  g_autoptr(XdpScannerSession) session = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) options = NULL;
+  GVariantBuilder options_builder;
+  ScannerDevice *device = NULL;
+  const char *token;
+  gboolean granted;
+
+  static const XdpOptionKey scanner_open_options[] = {
+    { "session_handle_token", G_VARIANT_TYPE_STRING, NULL },
+  };
+
+  g_debug ("[scanner] Handling OpenScanner");
+
+  g_variant_builder_init (&options_builder, G_VARIANT_TYPE_VARDICT);
+  if (!xdp_filter_options (arg_options, &options_builder,
+                           scanner_open_options, G_N_ELEMENTS (scanner_open_options),
+                           NULL, &error))
+    {
+      g_variant_builder_clear (&options_builder);
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+  options = g_variant_ref_sink (g_variant_builder_end (&options_builder));
+
+  /* Like a request's handle_token, the token is optional here; the portal makes the handle
+   * unique if the application's token is taken. */
+  token = lookup_session_token (options);
+  if (token == NULL)
+    token = "t";
+
+  g_mutex_lock (&self->mutex);
+  granted = g_hash_table_contains (scanner_grants_from_app_info (app_info), arg_scanner_id);
+  g_mutex_unlock (&self->mutex);
+
+  if (!granted)
+    {
+      g_dbus_method_invocation_return_error (invocation, XDG_DESKTOP_PORTAL_ERROR,
+                                             XDG_DESKTOP_PORTAL_ERROR_NOT_ALLOWED,
+                                             "The scanner was not granted to this application");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  /* Where the scanner is now, since a USB scanner that was unplugged and plugged in again has a
+   * new SANE name */
+  devices = scanner_enumerate (self);
+  for (guint i = 0; i < devices->len; i++)
+    {
+      ScannerDevice *candidate = g_ptr_array_index (devices, i);
+
+      if (g_strcmp0 (candidate->id, arg_scanner_id) == 0)
+        {
+          device = candidate;
+          break;
+        }
+    }
+
+  if (device == NULL || device->sane_name == NULL)
+    {
+      g_dbus_method_invocation_return_error (invocation, XDG_DESKTOP_PORTAL_ERROR,
+                                             XDG_DESKTOP_PORTAL_ERROR_FAILED,
+                                             "The scanner is not available");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  session = xdp_scanner_session_new (self, g_dbus_method_invocation_get_connection (invocation),
+                                     g_dbus_method_invocation_get_sender (invocation),
+                                     app_info, arg_scanner_id, token, &error);
+  if (session == NULL)
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  /* Take the lock before opening, so that two applications asking at once cannot both open it */
+  g_mutex_lock (&self->mutex);
+  if (g_hash_table_contains (self->open_scanners, arg_scanner_id))
+    {
+      g_mutex_unlock (&self->mutex);
+      g_dbus_method_invocation_return_error (invocation, XDG_DESKTOP_PORTAL_ERROR,
+                                             XDG_DESKTOP_PORTAL_ERROR_BUSY,
+                                             "The scanner is in use");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+  g_hash_table_insert (self->open_scanners, g_strdup (arg_scanner_id), session);
+  g_mutex_unlock (&self->mutex);
+
+  if (!scanner_session_open (session, device->sane_name, &error))
+    {
+      /* Never exported or registered: dropping the last reference releases the lock */
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  if (!xdp_session_export (XDP_SESSION (session), &error))
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      xdp_session_close (XDP_SESSION (g_steal_pointer (&session)), FALSE);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  xdp_session_register (XDP_SESSION (session));
+
+  g_debug ("[scanner] Opened %s as session %s", arg_scanner_id, XDP_SESSION (session)->id);
+
+  xdp_dbus_scanner_complete_open_scanner (object, invocation, XDP_SESSION (session)->id);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
