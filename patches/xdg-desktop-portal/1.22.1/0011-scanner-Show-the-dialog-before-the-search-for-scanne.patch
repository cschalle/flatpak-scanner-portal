+/* How long SelectScanners waits for the drivers before it shows the dialog with what it has. The
+ * ones for scanners on USB answer in a few milliseconds; the dialog should not wait for the ones
+ * that search the network. */
+#define SELECT_GRACE_MS 300
+
+/* The search for scanners that SelectScanners starts. The thread that runs it hands the scanners
+ * to the call until the call has taken what there was after SELECT_GRACE_MS, and to the dialog as
+ * they come after that. */
+typedef struct
+{
+  GMutex mutex;
+  GCond cond;
+  XdpRequest *request;    /* a reference; the request data has the candidates and the flag */
+  XdpScanner *scanner;
+  GCancellable *cancellable;
+  GPtrArray *slots;       /* per backend: the ScannerDevice it found, NULL until it answers */
+  GPtrArray *before;      /* what came before the hand-over, in the order of the drivers */
+  gboolean handed_over;
+  gboolean done;
+} SelectSearch;
+
+static void
+select_search_free (SelectSearch *search)
+{
+  g_clear_object (&search->request);
+  g_clear_object (&search->scanner);
+  g_clear_object (&search->cancellable);
+  g_clear_pointer (&search->slots, g_ptr_array_unref);
+  g_clear_pointer (&search->before, g_ptr_array_unref);
+  g_mutex_clear (&search->mutex);
+  g_cond_clear (&search->cond);
+  g_free (search);
+}
+
+static SelectSearch *
+select_search_new (XdpRequest *request,
+                   XdpScanner *scanner,
+                   GCancellable *cancellable)
+{
+  SelectSearch *search = g_new0 (SelectSearch, 1);
+
+  g_mutex_init (&search->mutex);
+  g_cond_init (&search->cond);
+  search->request = g_object_ref (request);
+  search->scanner = g_object_ref (scanner);
+  search->cancellable = g_object_ref (cancellable);
+  search->before = g_ptr_array_new ();   /* the devices belong to slots */
+
+  return search;
+}
+
+/* Adds the scanners that have what the application asked for to the candidates, and to builder
+ * if it is not NULL. The request must be locked. */
+static void
+select_offer (SelectData      *data,
+              GPtrArray       *devices,
+              GVariantBuilder *builder)
+{
+  for (guint i = 0; i < devices->len; i++)
+    {
+      ScannerDevice *device = g_ptr_array_index (devices, i);
+      GVariant *entry;
+
+      if (!scanner_device_has_capabilities (device, (const char * const *) data->required))
+        continue;
+
+      entry = g_variant_ref_sink (scanner_device_to_variant (device));
+      if (builder != NULL)
+        g_variant_builder_add_value (builder, entry);
+      g_hash_table_insert (data->candidates, g_strdup (device->id), entry);
+    }
+}
+
+static void
+select_update_done (GObject      *source_object,
+                    GAsyncResult *result,
+                    gpointer      user_data)
+{
+  g_autoptr(GError) error = NULL;
+
+  if (!xdp_dbus_impl_scanner_call_update_scanners_finish (XDP_DBUS_IMPL_SCANNER (source_object),
+                                                          result, &error))
+    g_debug ("[scanner] The backend did not take the scanners it was sent: %s", error->message);
+}
+
+/* Sends the dialog the scanners that were found after it was shown */
+static void
+select_send_update (SelectSearch *search,
+                    GPtrArray    *devices,
+                    gboolean      searching)
+{
+  XdpRequest *request = search->request;
+  SelectData *data;
+  GVariantBuilder builder;
+
+  REQUEST_AUTOLOCK (request);
+
+  data = g_object_get_data (G_OBJECT (request), "scanner-select");
+  if (data == NULL || data->finished)
+    return;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(sa{sv})"));
+  if (devices != NULL)
+    select_offer (data, devices, &builder);
+
+  g_debug ("[scanner] Sending %u more scanner(s) to the dialog, still searching: %s",
+           devices != NULL ? devices->len : 0, searching ? "yes" : "no");
+  xdp_dbus_impl_scanner_call_update_scanners (search->scanner->impl, request->id,
+                                              g_variant_builder_end (&builder), searching,
+                                              NULL, select_update_done, NULL);
+}
+
+static void
+select_search_batch (GPtrArray *devices,
+                     guint      index,
+                     guint      total,
+                     gpointer   user_data)
+{
+  SelectSearch *search = user_data;
+  gboolean forward;
+  gboolean searching;
+
+  g_mutex_lock (&search->mutex);
+
+  if (search->slots == NULL)
+    {
+      search->slots = g_ptr_array_new_full (total, (GDestroyNotify) g_ptr_array_unref);
+      g_ptr_array_set_size (search->slots, total);
+    }
+  g_ptr_array_index (search->slots, index) = g_ptr_array_ref (devices);
+
+  forward = search->handed_over;
+  if (!forward)
+    {
+      /* The call still builds its list, from the order of the drivers */
+      for (guint k = 0; k < devices->len; k++)
+        g_ptr_array_add (search->before, g_ptr_array_index (devices, k));
+      g_cond_broadcast (&search->cond);
+    }
+
+  searching = FALSE;
+  for (guint i = 0; i < search->slots->len; i++)
+    searching |= g_ptr_array_index (search->slots, i) == NULL;
+  g_mutex_unlock (&search->mutex);
+
+  if (forward)
+    select_send_update (search, devices, searching);
+
+  g_ptr_array_unref (devices);
+}
+
+static gpointer
+select_search_thread (gpointer user_data)
+{
+  SelectSearch *search = user_data;
+  XdpScanner *self = search->scanner;
+  Collected collected;
+  GPtrArray *all;
+  gboolean complete;
+
+  complete = scanner_discover (select_search_batch, search, search->cancellable);
+
+  /* The call reads what it was given before the search is over, so wait for it to be done with
+   * that before the devices go anywhere else */
+  g_mutex_lock (&search->mutex);
+  search->done = TRUE;
+  g_cond_broadcast (&search->cond);
+  while (!search->handed_over)
+    g_cond_wait (&search->cond, &search->mutex);
+  g_mutex_unlock (&search->mutex);
+
+  /* What was found is the list of scanners now, to the calls that ask for one in the next
+   * seconds, unless the search was cut short and may have missed some */
+  collected.slots = search->slots;
+  all = scanner_flatten (&collected);
+  if (complete)
+    {
+      g_mutex_lock (&self->mutex);
+      g_clear_pointer (&self->cached_devices, g_ptr_array_unref);
+      self->cached_devices = g_steal_pointer (&all);
+      self->cached_at = g_get_monotonic_time ();
+      g_mutex_unlock (&self->mutex);
+    }
+  g_clear_pointer (&all, g_ptr_array_unref);
+
+  select_send_update (search, NULL, FALSE);
+
+  select_search_free (search);
+
+  return NULL;
+}
+
+/* What the search has found by now, once it is found it all or SELECT_GRACE_MS have passed, as the
+ * scanners the dialog gets and whether it is still looking. From here on the search sends
+ * the rest to the dialog. The request must be locked. */
+static GVariant *
+select_search_take (SelectSearch *search,
+                    SelectData   *data,
+                    gboolean     *searching)
+{
+  GVariantBuilder builder;
+  gint64 until = g_get_monotonic_time () + SELECT_GRACE_MS * 1000;
+
+  g_mutex_lock (&search->mutex);
+  while (!search->done && g_cond_wait_until (&search->cond, &search->mutex, until))
+    ;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(sa{sv})"));
+  select_offer (data, search->before, &builder);
+  *searching = !search->done;
+  search->handed_over = TRUE;
+  g_cond_broadcast (&search->cond);
+  g_mutex_unlock (&search->mutex);
+
+  return g_variant_ref_sink (g_variant_builder_end (&builder));
+}
