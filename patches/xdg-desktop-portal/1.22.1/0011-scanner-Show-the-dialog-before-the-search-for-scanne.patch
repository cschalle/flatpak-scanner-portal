+
+/* A configuration directory under root that loads one backend, with the backend's own files of
+ * the real one. libsane lists the backends one after another, so asking each alone, at the same
+ * time, takes as long as the slowest instead of the sum. */
+static char *
+scanner_backend_config (const char *root,
+                        const char *backend,
+                        GPtrArray  *dirs)
+{
+  g_autofree char *config = g_build_filename (root, backend, NULL);
+  g_autofree char *dll_conf = g_build_filename (config, "dll.conf", NULL);
+  g_autofree char *line = g_strdup_printf ("%s\n", backend);
+  g_autofree char *prefix = g_strdup_printf ("%s.", backend);
+
+  if (g_mkdir (config, 0700) != 0 || !g_file_set_contents (dll_conf, line, -1, NULL))
+    return NULL;
+
+  for (guint i = 0; i < dirs->len; i++)
+    {
+      const char *dir = g_ptr_array_index (dirs, i);
+      g_autoptr(GDir) d = g_dir_open (dir, 0, NULL);
+      const char *entry;
+
+      while (d != NULL && (entry = g_dir_read_name (d)) != NULL)
+        {
+          g_autofree char *source = NULL;
+          g_autofree char *link = NULL;
+
+          if (!g_str_has_prefix (entry, prefix))
+            continue;
+
+          source = g_build_filename (dir, entry, NULL);
+          link = g_build_filename (config, entry, NULL);
+          if (symlink (source, link) != 0 && errno != EEXIST)
+            g_warning ("[scanner] Could not link %s: %s", source, g_strerror (errno));
+        }
+    }
+
+  return g_steal_pointer (&config);
+}
+
+/* Called with the scanners one backend found, as soon as it has answered, and takes the list.
+ * total is how many backends are asked and index tells which this is, for callers that want a
+ * stable order. */
+typedef void (*ScannerDiscoverBatch) (GPtrArray *devices,
+                                      guint      index,
+                                      guint      total,
+                                      gpointer   user_data);
+
+typedef struct _Discovery Discovery;
+
+typedef struct
+{
+  Discovery *discovery;
+  guint index;
+  GSubprocess *subprocess;
+  GCancellable *cancellable;
+  GSource *timeout;
+} DiscoveryJob;
+
+struct _Discovery
+{
+  GMainLoop *loop;
+  const char *helper;
+  GPtrArray *backends;      /* names, or NULL for one run of the helper with the whole config */
+  GPtrArray *dirs;
+  char *root;               /* the directory holding the per-backend configurations */
+  guint total;
+  guint next;
+  guint pending;
+  gboolean complete;        /* every backend answered */
+  gboolean failed;
+  GPtrArray *jobs;          /* DiscoveryJob, those running */
+  ScannerDiscoverBatch batch;
+  gpointer user_data;
+};
+
+static void discovery_start_more (Discovery *d);
+
+static void
+discovery_job_free (DiscoveryJob *job)
+{
+  if (job->timeout != NULL)
+    {
+      g_source_destroy (job->timeout);
+      g_source_unref (job->timeout);
+    }
+  g_clear_object (&job->subprocess);
+  g_clear_object (&job->cancellable);
+  g_free (job);
+}
+
+static gboolean
+discovery_job_timed_out (gpointer data)
+{
+  DiscoveryJob *job = data;
+
+  g_warning ("[scanner] A scanner listing took longer than %d seconds, giving up on it", HELPER_TIMEOUT_SECONDS);
+  g_cancellable_cancel (job->cancellable);
+  g_subprocess_force_exit (job->subprocess);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+discovery_job_done (GObject      *source_object,
+                    GAsyncResult *result,
+                    gpointer      user_data)
+{
+  DiscoveryJob *job = user_data;
+  Discovery *d = job->discovery;
+  g_autoptr(GBytes) stdout_bytes = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GPtrArray) devices = NULL;
+
+  if (g_subprocess_communicate_finish (G_SUBPROCESS (source_object), result, &stdout_bytes, NULL, &error) &&
+      stdout_bytes != NULL &&
+      g_subprocess_get_if_exited (job->subprocess) &&
+      g_subprocess_get_exit_status (job->subprocess) == 0)
+    {
+      devices = scanner_parse_helper_list (stdout_bytes);
+    }
+  else if (!g_cancellable_is_cancelled (job->cancellable))
+    {
+      g_debug ("[scanner] A scanner listing failed");
+    }
+
+  if (devices == NULL)
+    d->failed = TRUE;
+  else if (d->batch != NULL)
+    d->batch (g_steal_pointer (&devices), job->index, d->total, d->user_data);
+
+  g_ptr_array_remove (d->jobs, job);
+  discovery_job_free (job);
+  d->pending--;
+
+  discovery_start_more (d);
+  if (d->pending == 0 && d->next >= d->total)
+    {
+      d->complete = !d->failed;
+      g_main_loop_quit (d->loop);
+    }
+}
+
+static void
+discovery_start_job (Discovery *d,
+                     guint      index)
+{
+  g_autoptr(GSubprocessLauncher) launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_SILENCE);
+  g_autoptr(GError) error = NULL;
+  DiscoveryJob *job;
+
+  job = g_new0 (DiscoveryJob, 1);
+  job->discovery = d;
+  job->index = index;
+
+  if (d->backends != NULL)
+    {
+      g_autofree char *config = scanner_backend_config (d->root, g_ptr_array_index (d->backends, index), d->dirs);
+
+      if (config != NULL)
+        g_subprocess_launcher_setenv (launcher, "SANE_CONFIG_DIR", config, TRUE);
+    }
+
+  job->subprocess = g_subprocess_launcher_spawn (launcher, &error, d->helper, "list", NULL);
+  if (job->subprocess == NULL)
+    {
+      g_warning ("[scanner] Failed to run %s: %s", d->helper, error->message);
+      d->failed = TRUE;
+      g_free (job);
+      return;
+    }
+
+  job->cancellable = g_cancellable_new ();
+  job->timeout = g_timeout_source_new_seconds (HELPER_TIMEOUT_SECONDS);
+  g_source_set_callback (job->timeout, discovery_job_timed_out, job, NULL);
+  g_source_attach (job->timeout, g_main_context_get_thread_default ());
+
+  g_ptr_array_add (d->jobs, job);
+  d->pending++;
+  g_subprocess_communicate_async (job->subprocess, NULL, job->cancellable, discovery_job_done, job);
+}
+
+static void
+discovery_start_more (Discovery *d)
+{
+  while (d->pending < DISCOVER_PARALLEL && d->next < d->total)
+    discovery_start_job (d, d->next++);
+}
+
+static gboolean
+discovery_cancelled (GObject  *cancellable,
+                     gpointer  user_data)
+{
+  Discovery *d = user_data;
+
+  for (guint i = 0; i < d->jobs->len; i++)
+    {
+      DiscoveryJob *job = g_ptr_array_index (d->jobs, i);
+
+      g_cancellable_cancel (job->cancellable);
+      g_subprocess_force_exit (job->subprocess);
+    }
+  d->next = d->total;
+  d->failed = TRUE;
+
+  return G_SOURCE_REMOVE;
+}
+
+/* Asks libsane for the scanners with a helper per backend, running side by side, and calls batch
+ * for each as it answers. Returns TRUE if every one answered; FALSE if it was cancelled or one
+ * failed. Blocks until then. Probing can take seconds, and some backends reset the scanner they
+ * find, so callers should not do this more than they have to. */
+static gboolean
+scanner_discover (ScannerDiscoverBatch  batch,
+                  gpointer              user_data,
+                  GCancellable         *cancellable)
+{
+  g_autoptr(GMainContext) context = g_main_context_new ();
+  g_autoptr(GSource) cancel_source = NULL;
+  Discovery d = { 0, };
+  gboolean complete;
+
+  d.helper = g_getenv ("XDP_SCANNER_HELPER");
+  if (d.helper == NULL)
+    d.helper = LIBEXECDIR "/xdg-desktop-portal-scanner-helper";
+
+  d.dirs = scanner_config_dirs ();
+  d.backends = scanner_backend_names (d.dirs);
+  d.total = d.backends != NULL ? d.backends->len : 1;
+  d.jobs = g_ptr_array_new ();
+  d.batch = batch;
+  d.user_data = user_data;
+
+  if (d.backends != NULL)
+    {
+      d.root = g_dir_make_tmp ("xdp-scanner-XXXXXX", NULL);
+      if (d.root == NULL)
+        g_clear_pointer (&d.backends, g_ptr_array_unref);   /* ask for everything in one go instead */
+      d.total = d.backends != NULL ? d.backends->len : 1;
+    }
+
+  g_main_context_push_thread_default (context);
+  d.loop = g_main_loop_new (context, FALSE);
+
+  if (cancellable != NULL)
+    {
+      cancel_source = g_cancellable_source_new (cancellable);
+      g_source_set_callback (cancel_source, G_SOURCE_FUNC (discovery_cancelled), &d, NULL);
+      g_source_attach (cancel_source, context);
+    }
+
+  discovery_start_more (&d);
+  if (d.pending == 0)
+    d.failed = TRUE;
+  else
+    g_main_loop_run (d.loop);
+
+  complete = d.complete;
+
+  if (cancel_source != NULL)
+    g_source_destroy (cancel_source);
+  g_main_context_pop_thread_default (context);
+  g_main_loop_unref (d.loop);
+  if (d.root != NULL)
+    scanner_remove_tree (d.root);
+  g_free (d.root);
+  g_clear_pointer (&d.backends, g_ptr_array_unref);
+  g_clear_pointer (&d.dirs, g_ptr_array_unref);
+  g_clear_pointer (&d.jobs, g_ptr_array_unref);
+
+  return complete;
+}
+
+typedef struct
+{
+  GPtrArray *slots;   /* per backend index: a GPtrArray of ScannerDevice, or NULL */
+} Collected;
+
+static void
+collect_batch (GPtrArray *devices,
+               guint      index,
+               guint      total,
+               gpointer   user_data)
+{
+  Collected *collected = user_data;
+
+  if (collected->slots == NULL)
+    {
+      collected->slots = g_ptr_array_new_full (total, (GDestroyNotify) g_ptr_array_unref);
+      g_ptr_array_set_size (collected->slots, total);
+    }
+
+  g_ptr_array_index (collected->slots, index) = devices;
+}
+
+/* Everything the backends found, in the order of the backends */
+static GPtrArray *
+scanner_flatten (Collected *collected)
+{
+  GPtrArray *all = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_device_free);
+
+  for (guint i = 0; collected->slots != NULL && i < collected->slots->len; i++)
+    {
+      GPtrArray *devices = g_ptr_array_index (collected->slots, i);
+      gsize n = 0;
+      gpointer *items;
+
+      if (devices == NULL)
+        continue;
+
+      items = g_ptr_array_steal (devices, &n);
+      for (gsize k = 0; k < n; k++)
+        g_ptr_array_add (all, items[k]);
+      g_free (items);
+    }
+
+  return all;
+}
+
+/* Runs the helpers and waits for all of them */
+static GPtrArray *
+scanner_enumerate_with_helper (void)
+{
+  Collected collected = { NULL, };
+  GPtrArray *all;
+
+  scanner_discover (collect_batch, &collected, NULL);
+  all = scanner_flatten (&collected);
+  g_clear_pointer (&collected.slots, g_ptr_array_unref);
+
+  return all;
 }
 
