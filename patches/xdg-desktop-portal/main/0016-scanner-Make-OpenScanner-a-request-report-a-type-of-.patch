+/* What kind of device it is, in the portal's words: `film` for a scanner that is only for film,
+ * `camera` and `virtual` for what is not a scanner, `scanner` for the rest. The driver's own type
+ * says little and differs between drivers; the capabilities are the portal's. */
+static const char *
+scanner_portal_type (const char         *raw,
+                     const char * const *capabilities)
+{
+  g_autofree char *lower = g_ascii_strdown (raw != NULL ? raw : "", -1);
+
+  if (strstr (lower, "camera") != NULL || strstr (lower, "webcam") != NULL)
+    return "camera";
+  if (strstr (lower, "virtual") != NULL)
+    return "virtual";
+
+  if (capabilities != NULL &&
+      g_strv_contains (capabilities, "film") &&
+      !g_strv_contains (capabilities, "flatbed") &&
+      !g_strv_contains (capabilities, "adf"))
+    return "film";
+
+  return "scanner";
+}
+
 /* From one entry of the helper's list: an id, the SANE name and the information vardict. What the
  * portal knows about the scanner is added: its capabilities, and an id that is the same for every
  * driver that finds it, so that they are one scanner to the dialog and to applications. */
@@ -531,9 +559,22 @@ scanner_device_new_from_helper (const char *id,
   g_variant_dict_insert_value (&dict, "capabilities", g_variant_new_strv ((const char * const *) caps->pdata, -1));
   device->capabilities = g_strdupv ((char **) caps->pdata);
 
+  /* The driver's own type is free text and can hold an address, so applications get the portal's
+   * word for what the device is instead */
+  {
+    const char *raw = NULL;
+
+    g_variant_dict_lookup (&dict, "type", "&s", &raw);
+    g_variant_dict_insert (&dict, "type", "s", scanner_portal_type (raw, (const char * const *) device->capabilities));
+  }
+
   device->physical = g_strdup (physical);
   device->sane_name = g_strdup (sane_name);
   device->rank = scanner_backend_rank (table, backend);
+  /* A scanner whose entry names a driver is opened with that one when it is among the drivers that
+   * found it: ahead of every rank, so that it does not depend on how the others compare */
+  if (known != NULL && known->driver != NULL && g_strcmp0 (known->driver, backend) == 0)
+    device->rank = SCANNER_PREFERRED_RANK;
   device->candidates = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_candidate_free);
   {
     ScannerCandidate *candidate = g_new0 (ScannerCandidate, 1);
@@ -562,6 +603,30 @@ scanner_device_new_from_helper (const char *id,
   return device;
 }
 
+/* Says in the information that the best driver is the one that drives the scanner, since
+ * applications match quirks on it, and the scanner may have been found by another first */
+static void
+scanner_device_set_backend (ScannerDevice *device)
+{
+  g_auto(GVariantDict) dict = G_VARIANT_DICT_INIT (device->info);
+  g_autofree char *backend = g_strndup (device->sane_name, strchrnul (device->sane_name, ':') - device->sane_name);
+
+  g_variant_dict_insert (&dict, "backend", "s", backend);
+  g_variant_unref (device->info);
+  device->info = g_variant_ref_sink (g_variant_dict_end (&dict));
+}
+
+/* Whether a comes before b: the lower rank, and for equal ranks the driver whose name sorts first */
+static gboolean
+scanner_candidate_before (const ScannerCandidate *a,
+                          const ScannerCandidate *b)
+{
+  if (a->rank != b->rank)
+    return a->rank < b->rank;
+
+  return g_strcmp0 (a->name, b->name) < 0;
+}
+
