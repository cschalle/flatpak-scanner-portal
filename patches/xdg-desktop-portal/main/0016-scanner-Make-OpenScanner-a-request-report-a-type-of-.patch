   g_free (data);
 }
 
+/* The information of a scanner in the list of the last complete search, or NULL if there is none or
+ * it is not in it. The scanner mutex must be held. */
+static GVariant *
+scanner_cached_info (XdpScanner *self,
+                     const char *id)
+{
+  for (guint i = 0; self->cached_devices != NULL && i < self->cached_devices->len; i++)
+    {
+      ScannerDevice *device = g_ptr_array_index (self->cached_devices, i);
+
+      if (g_strcmp0 (device->id, id) == 0)
+        return g_variant_ref (device->info);
+    }
+
+  return NULL;
+}
