--- a/desktop-portal/scanner-helper.c
+++ b/desktop-portal/scanner-helper.c
@@ -1247,6 +1247,23 @@ buttons_poll (Buttons    *buttons,
     }
 }
 
+/* Why a driver did not open a scanner, for the portal to decide whether another driver may try.
+ * `unsupported` is the driver saying it does not drive this device. An I/O error is not that: the
+ * driver may have talked to the device before it failed, and a second driver on a device in an
+ * unknown state is how a scanner gets reset. */
+static const char *
+open_failure_kind (SANE_Status status)
+{
+  if (status == SANE_STATUS_DEVICE_BUSY)
+    return "busy";
+  if (status == SANE_STATUS_ACCESS_DENIED)
+    return "denied";
+  if (status == SANE_STATUS_INVAL || status == SANE_STATUS_UNSUPPORTED)
+    return "unsupported";
+
+  return "failed";
+}
+
 static int
 run_session (const char *name,
              int         argc,
@@ -1278,8 +1295,7 @@ run_session (const char *name,
   status = sane_open (name, &handle);
   if (status != SANE_STATUS_GOOD)
     {
-      send_failure (0, status == SANE_STATUS_DEVICE_BUSY ? "busy" : "failed",
-                    sane_strstatus (status));
+      send_failure (0, open_failure_kind (status), sane_strstatus (status));
       sane_exit ();
       return 1;
     }
