-          while (at > 0 && ((ScannerCandidate *) g_ptr_array_index (first->candidates, at - 1))->rank > candidate->rank)
+          /* Equal ranks are ordered by the driver's name, never by which one answered first */
+          while (at > 0 && scanner_candidate_before (candidate, g_ptr_array_index (first->candidates, at - 1)))
