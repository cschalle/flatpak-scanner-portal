+/* The buttons of a driver's scanners: which options of the backend are buttons, and what they are
+ * called to applications. Read by the helper, which tells the portal when one is pressed. */
+typedef struct
+{
+  int interval_ms;
+  char *trigger;        /* a button option to press before the others are read, or NULL */
+  GPtrArray *options;   /* char *: the backend's name, then the portal's, alternating */
+} ScannerButtons;
+
+static void
+scanner_buttons_free (ScannerButtons *buttons)
+{
+  g_free (buttons->trigger);
+  g_clear_pointer (&buttons->options, g_ptr_array_unref);
+  g_free (buttons);
+}
+
 typedef struct
 {
   GPtrArray *known;     /* ScannerKnown */
+  GHashTable *buttons;  /* backend (char *) -> ScannerButtons */
   GHashTable *ranks;    /* backend (char *) -> rank (GINT_TO_POINTER) */
   int default_rank;
   char *path;
@@ -195,6 +213,7 @@ scanner_table_free (ScannerTable *table)
 {
   g_clear_pointer (&table->known, g_ptr_array_unref);
   g_clear_pointer (&table->ranks, g_hash_table_unref);
+  g_clear_pointer (&table->buttons, g_hash_table_unref);
   g_free (table->path);
   g_free (table);
 }
@@ -263,6 +282,7 @@ scanner_table_load (const char *path,
 
   table->known = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_known_free);
   table->ranks = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  table->buttons = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, (GDestroyNotify) scanner_buttons_free);
   table->default_rank = SCANNER_DEFAULT_RANK;
   table->path = g_strdup (path);
   table->mtime = mtime;
@@ -320,17 +340,55 @@ scanner_table_load (const char *path,
       }
   }
 
+  {
+    JsonObject *object = json_node_get_object (root);
+    JsonObject *backends = json_object_has_member (object, "buttons") ? json_object_get_object_member (object, "buttons") : NULL;
+    g_autoptr(GList) names = backends != NULL ? json_object_get_members (backends) : NULL;
+
+    for (GList *l = names; l != NULL; l = l->next)
+      {
+        JsonObject *entry = json_object_get_object_member (backends, l->data);
+        JsonObject *options = entry != NULL && json_object_has_member (entry, "options") ? json_object_get_object_member (entry, "options") : NULL;
+        g_autoptr(GList) option_names = options != NULL ? json_object_get_members (options) : NULL;
+        ScannerButtons *buttons;
+
+        if (option_names == NULL)
+          continue;
+
+        buttons = g_new0 (ScannerButtons, 1);
+        buttons->interval_ms = json_object_has_member (entry, "interval_ms") ? (int) json_object_get_int_member (entry, "interval_ms") : 250;
+        if (json_object_has_member (entry, "trigger"))
+          buttons->trigger = g_strdup (json_object_get_string_member (entry, "trigger"));
+        buttons->options = g_ptr_array_new_with_free_func (g_free);
+        for (GList *o = option_names; o != NULL; o = o->next)
