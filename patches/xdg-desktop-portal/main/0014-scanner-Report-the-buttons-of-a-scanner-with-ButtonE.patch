From 907eb94fd2f548145cf4cfbaa098475a2669990c Mon Sep 17 00:00:00 2001
From: "Christian F.K. Schaller" <christian.schaller@gmail.com>
Date: Tue, 27 Oct 2026 19:29:13 -0400
Subject: [PATCH] scanner: Report the buttons of a scanner with ButtonEvent

SANE has no event for the buttons on a scanner. The helper reads the sensor
options that scanner-devices.json names as buttons, between the requests of
a session and not while a frame is in progress, and tells the frontend when
one goes from released to pressed. The frontend sends ButtonEvent to the
application that has the scanner open, and lists the names of the buttons in
the scanner's info.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 data/org.freedesktop.portal.Scanner.xml |  36 +++++
 data/scanner-devices.json               |  68 +++++----
 desktop-portal/scanner-helper.c         | 186 +++++++++++++++++++++++-
 desktop-portal/scanner.c                | 149 ++++++++++++++++++-
 4 files changed, 405 insertions(+), 34 deletions(-)

diff --git a/data/org.freedesktop.portal.Scanner.xml b/data/org.freedesktop.portal.Scanner.xml
index 160b79f..803cac6 100644
--- a/data/org.freedesktop.portal.Scanner.xml
+++ b/data/org.freedesktop.portal.Scanner.xml
@@ -159,6 +159,14 @@
           reliable enough to filter on; GetOptions() is still authoritative
           for what an opened scanner can do.
 
+        * ``buttons`` (``as``)
+
+          The buttons of the scanner that the portal can report, with
+          ButtonEvent, by the names the portal gives them: ``scan``,
+          ``copy``, ``email``, ``pdf``, ``file`` or ``extra``. Empty when
+          the scanner has none, or its driver is not one the portal knows
+          the buttons of.
+
         * ``available`` (``b``)
 
           Whether the scanner can be opened right now.
@@ -453,6 +461,34 @@
       <arg type="a{sv}" name="details" direction="out"/>
     </signal>
 
+    <!--
+        ButtonEvent:
+        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` of the open scanner
+        @scanner_id: The scanner
+        @button: The name of the button, one of ``scan``, ``copy``, ``email``, ``pdf``, ``file`` or ``extra``
+        @details: Vardict with further information
+
+        A button on the scanner was pressed. It is sent to the application
+        that has the scanner open, with the session it opened it with. The
+        portal reads the buttons between the calls of a session and not while
+        a frame is in progress, so a press during a scan is lost, and a
+        button that was down when the session opened is not a press.
+
+        Keys in @details:
+
+        * ``option`` (``s``)
+
+          The name the driver has for the button, such as ``intelliscan``,
+          for telling apart two buttons that have the same @button.
+    -->
+    <signal name="ButtonEvent">
+      <arg type="o" name="session_handle" direction="out"/>
+      <arg type="s" name="scanner_id" direction="out"/>
+      <arg type="s" name="button" direction="out"/>
+      <annotation name="org.qtproject.QtDBus.QtTypeName.Out3" value="QVariantMap"/>
+      <arg type="a{sv}" name="details" direction="out"/>
+    </signal>
+
     <property name="version" type="u" access="read"/>
   </interface>
 </node>
