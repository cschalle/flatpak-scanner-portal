diff --git a/desktop-portal/scanner-helper.c b/desktop-portal/scanner-helper.c
index 816ea55..da40618 100644
--- a/desktop-portal/scanner-helper.c
+++ b/desktop-portal/scanner-helper.c
@@ -16,7 +16,9 @@
  *     the scanner could be opened.
  */
 
+#include <errno.h>
 #include <fcntl.h>
+#include <poll.h>
 #include <pthread.h>
 #include <signal.h>
 #include <stdio.h>
@@ -1096,10 +1098,162 @@ stop_frame (Session *session)
     g_thread_join (g_steal_pointer (&session->thread));
 }
 
+/* ---- Buttons ----
+ *
+ * SANE has no event for the buttons of a scanner. A backend that has them exposes sensor options
+ * that read true (or a number that is not zero) while a button is down or, for some backends, until
+ * they are read. The portal says which options are buttons, and what it calls them, in the
+ * arguments of the helper; the helper reads them between the requests of the session, and tells the
+ * portal when one goes from released to pressed. What a button is called is the portal's: this only
+ * reads.
+ *
+ * The scanner is read from the thread that serves requests and only while no frame is in progress,
+ * since many backends cannot read a sensor in the middle of a scan: a press during a scan is lost. */
+
+typedef struct
+{
+  char *option;       /* the backend's name for it: "scan" */
+  char *name;         /* the portal's: "scan" */
+  SANE_Int index;     /* 0 if the scanner has no such option */
+  const SANE_Option_Descriptor *desc;
+  int last;           /* what the last reading was, so that a press is a change */
+} ButtonWatch;
+
+typedef struct
+{
+  GArray *watches;    /* ButtonWatch */
+  int interval_ms;
+  char *trigger;      /* a button option to press before reading, or NULL */
+  SANE_Int trigger_index;
+} Buttons;
+
+/* The arguments after the scanner's name: --button-interval=MS, --button-trigger=OPTION and
+ * --button=OPTION=NAME, as many of the last as there are buttons. Anything else is an error. */
+static gboolean
+buttons_parse (Buttons *buttons,
+               int      argc,
+               char    *argv[])
+{
+  buttons->watches = g_array_new (FALSE, TRUE, sizeof (ButtonWatch));
+  buttons->interval_ms = 250;
+
+  for (int i = 0; i < argc; i++)
+    {
+      if (g_str_has_prefix (argv[i], "--button-interval="))
+        {
+          buttons->interval_ms = (int) g_ascii_strtoll (argv[i] + strlen ("--button-interval="), NULL, 10);
+          if (buttons->interval_ms < 50)
+            buttons->interval_ms = 50;
+        }
+      else if (g_str_has_prefix (argv[i], "--button-trigger="))
+        {
+          g_free (buttons->trigger);
+          buttons->trigger = g_strdup (argv[i] + strlen ("--button-trigger="));
+        }
+      else if (g_str_has_prefix (argv[i], "--button="))
+        {
+          const char *spec = argv[i] + strlen ("--button=");
+          const char *equals = strchr (spec, '=');
+          ButtonWatch watch = { 0 };
+
+          if (equals == NULL || equals == spec || equals[1] == '\0')
+            return FALSE;
+          watch.option = g_strndup (spec, equals - spec);
+          watch.name = g_strdup (equals + 1);
+          g_array_append_val (buttons->watches, watch);
+        }
+      else
+        {
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+static int
+button_read (SANE_Handle handle,
+             ButtonWatch *watch)
+{
+  SANE_Word value = 0;
+
+  if (watch->index == 0 ||
+      sane_control_option (handle, watch->index, SANE_ACTION_GET_VALUE, &value, NULL) != SANE_STATUS_GOOD)
+    return 0;
+
+  return value != 0;
+}
+
+/* Finds the options on the scanner that was opened, and takes the readings that a press is a change
+ * from. A button that is held at the start, or that a backend latches until it is read, is not
+ * a press. */
+static void
+buttons_start (Buttons    *buttons,
+               SANE_Handle handle)
+{
+  for (guint i = 0; i < buttons->watches->len; i++)
+    {
+      ButtonWatch *watch = &g_array_index (buttons->watches, ButtonWatch, i);
+
+      watch->index = option_find (handle, watch->option, &watch->desc);
+      /* Only a number the scanner can be asked for, and not a setting it was told */
+      if (watch->index != 0 &&
+          (!(watch->desc->type == SANE_TYPE_BOOL || watch->desc->type == SANE_TYPE_INT) ||
+           !SANE_OPTION_IS_ACTIVE (watch->desc->cap) || !(watch->desc->cap & SANE_CAP_SOFT_DETECT)))
+        watch->index = 0;
+    }
+
+  if (buttons->trigger != NULL)
+    {
+      const SANE_Option_Descriptor *desc = NULL;
+
+      buttons->trigger_index = option_find (handle, buttons->trigger, &desc);
+      if (desc != NULL && desc->type != SANE_TYPE_BUTTON)
+        buttons->trigger_index = 0;
+    }
+
+  if (buttons->trigger_index != 0)
+    sane_control_option (handle, buttons->trigger_index, SANE_ACTION_SET_VALUE, NULL, NULL);
+  for (guint i = 0; i < buttons->watches->len; i++)
+    {
+      ButtonWatch *watch = &g_array_index (buttons->watches, ButtonWatch, i);
+
+      watch->last = button_read (handle, watch);
+    }
+}
+
+static void
+buttons_poll (Buttons    *buttons,
+              SANE_Handle handle)
+{
+  if (buttons->trigger_index != 0)
+    sane_control_option (handle, buttons->trigger_index, SANE_ACTION_SET_VALUE, NULL, NULL);
+
+  for (guint i = 0; i < buttons->watches->len; i++)
+    {
+      ButtonWatch *watch = &g_array_index (buttons->watches, ButtonWatch, i);
+      int now = button_read (handle, watch);
+
+      if (now && !watch->last)
+        {
+          GVariantBuilder details;
+
+          g_variant_builder_init (&details, G_VARIANT_TYPE_VARDICT);
+          g_variant_builder_add (&details, "{sv}", "button", g_variant_new_string (watch->name));
+          g_variant_builder_add (&details, "{sv}", "option", g_variant_new_string (watch->option));
+          send_reply (0, TRUE, g_variant_new ("(s@a{sv})", "button", g_variant_builder_end (&details)));
+        }
+      watch->last = now;
+    }
+}
+
 static int
-run_session (const char *name)
+run_session (const char *name,
+             int         argc,
+             char       *argv[])
 {
   Session session = { 0 };
+  Buttons buttons = { 0 };
   SANE_Handle handle = NULL;
   SANE_Status status;
   gboolean running = TRUE;
@@ -1108,6 +1262,12 @@ run_session (const char *name)
   /* An application that closes its end of the pipe is an error from write(), not a signal */
   signal (SIGPIPE, SIG_IGN);
 
+  if (!buttons_parse (&buttons, argc, argv))
+    {
+      send_failure (0, "failed", "Malformed arguments");
+      return 2;
+    }
+
   status = sane_init (NULL, NULL);
   if (status != SANE_STATUS_GOOD)
     {
@@ -1125,6 +1285,7 @@ run_session (const char *name)
     }
 
   session.handle = handle;
+  buttons_start (&buttons, handle);
 
   if (!send_reply (0, TRUE, g_variant_new_string ("")))
     running = FALSE;
@@ -1139,6 +1300,23 @@ run_session (const char *name)
       int pass_fd = -1;
       gboolean busy;
 
+      /* With buttons to watch, look at them whenever no request has come for a while. The wait is
+       * for the start of a request only: once one has started, it is read to the end. */
+      if (buttons.watches->len > 0)
+        {
+          struct pollfd pfd = { .fd = SCANNER_HELPER_FD, .events = POLLIN };
+          int ready = poll (&pfd, 1, buttons.interval_ms);
+
+          if (ready < 0 && errno == EINTR)
+            continue;
+          if (ready == 0)
+            {
+              if (g_atomic_int_get (&session.busy) == 0 && !session.mid_scan)
+                buttons_poll (&buttons, handle);
+              continue;
+            }
+        }
+
       request = scanner_protocol_read_with_fd (SCANNER_HELPER_FD, G_VARIANT_TYPE ("(usv)"), -1,
                                                &pass_fd, &error);
       if (request == NULL)
@@ -1259,9 +1437,9 @@ main (int argc, char *argv[])
   if (argc == 2 && strcmp (argv[1], "list") == 0)
     return run_list ();
 
-  if (argc == 3 && strcmp (argv[1], "session") == 0)
-    return run_session (argv[2]);
+  if (argc >= 3 && strcmp (argv[1], "session") == 0)
+    return run_session (argv[2], argc - 3, argv + 3);
 
-  g_printerr ("usage: %s list | session NAME\n", argv[0]);
+  g_printerr ("usage: %s list | session NAME [--button-interval=MS] [--button-trigger=OPTION] [--button=OPTION=NAME]...\n", argv[0]);
   return 2;
 }
diff --git a/desktop-portal/scanner.c b/desktop-portal/scanner.c
