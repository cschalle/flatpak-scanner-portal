+/* The table as the file has it now, read again when the file is new or changed. It is called from
+ * the threads that search for scanners as well as the main one, so a table that has been replaced is
+ * kept, never freed: the file changes rarely and a table is small. */
 static const ScannerTable *
 scanner_table_get (void)
 {
+  static GMutex lock;
   static ScannerTable *table = NULL;
+  static GPtrArray *retired = NULL;
+  g_autoptr(GMutexLocker) locker = g_mutex_locker_new (&lock);
   g_autofree char *path = scanner_table_find_file ();
   gint64 mtime = 0;
 
@@ -347,7 +405,12 @@ scanner_table_get (void)
   if (table != NULL && g_strcmp0 (table->path, path) == 0 && table->mtime == mtime)
     return table;
 
-  g_clear_pointer (&table, scanner_table_free);
+  if (table != NULL)
+    {
+      if (retired == NULL)
+        retired = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_table_free);
+      g_ptr_array_add (retired, table);
+    }
   table = scanner_table_load (path, mtime);
   return table;
 }
@@ -392,6 +455,13 @@ scanner_backend_rank (const ScannerTable *table,
   return table->default_rank;
 }
 
+static const ScannerButtons *
+scanner_buttons_for (const ScannerTable *table,
+                     const char         *backend)
+{
+  return backend != NULL ? g_hash_table_lookup (table->buttons, backend) : NULL;
+}
+
 /* From one entry of the helper's list: an id, the SANE name and the information vardict. What the
  * portal knows about the scanner is added: its capabilities, and an id that is the same for every
  * driver that finds it, so that they are one scanner to the dialog and to applications. */
@@ -441,6 +511,23 @@ scanner_device_new_from_helper (const char *id,
     g_ptr_array_add (caps, g_strdup ("flatbed"));
   g_ptr_array_add (caps, NULL);
 
+  /* The names of the buttons the portal can report, which is none for a backend that is not in
+   * the table */
+  {
+    const ScannerButtons *buttons = scanner_buttons_for (table, backend);
+    g_autoptr(GPtrArray) names = g_ptr_array_new ();
+
+    for (guint i = 1; buttons != NULL && i < buttons->options->len; i += 2)
+      {
+        const char *name = g_ptr_array_index (buttons->options, i);
+
+        if (!g_ptr_array_find_with_equal_func (names, name, g_str_equal, NULL))
+          g_ptr_array_add (names, (gpointer) name);
+      }
+    g_ptr_array_add (names, NULL);
+    g_variant_dict_insert_value (&dict, "buttons", g_variant_new_strv ((const char * const *) names->pdata, -1));
+  }
+
   g_variant_dict_insert_value (&dict, "capabilities", g_variant_new_strv ((const char * const *) caps->pdata, -1));
   device->capabilities = g_strdupv ((char **) caps->pdata);
 
@@ -1828,6 +1915,34 @@ scanner_session_emit_frame_event (XdpScannerSession *self,
     g_warning ("[scanner] Failed to emit FrameEvent: %s", error->message);
 }
 
+/* Sends a ButtonEvent to the application that owns the session */
