From 7574af62e44740ac6efccda2c475c6e5678b1992 Mon Sep 17 00:00:00 2001
From: "Christian F.K. Schaller" <christian.schaller@gmail.com>
Date: Wed, 28 Oct 2026 15:17:58 -0400
Subject: [PATCH] scanner: Call the document feeder 'feeder' and reduce the
 device type to three words

The capability 'adf' is now 'feeder', as the other capabilities are words
and not letters. The type of a device is 'scanner', 'film' or 'other', which
is what an application needs to hide devices that are not scanners, and new
values may be added. 'camera' and 'virtual' were two words for the same
thing to an application.
---
 data/org.freedesktop.portal.Scanner.xml | 17 +++++++----------
 data/scanner-devices.json               |  2 +-
 desktop-portal/scanner-helper.c         |  2 +-
 desktop-portal/scanner.c                | 15 ++++++++-------
 4 files changed, 17 insertions(+), 19 deletions(-)

diff --git a/data/org.freedesktop.portal.Scanner.xml b/data/org.freedesktop.portal.Scanner.xml
index 21b15f5..b01238b 100644
--- a/data/org.freedesktop.portal.Scanner.xml
+++ b/data/org.freedesktop.portal.Scanner.xml
@@ -77,15 +77,16 @@
         * ``required_capabilities`` (``as``)
 
           Only offer scanners that have all of these capabilities. Known
-          values: ``film`` (transparency unit), ``adf``, ``infrared``,
-          ``flatbed``, ``color``. Unknown values are ignored.
+          values: ``film`` (transparency unit), ``feeder`` (automatic
+          document feeder), ``infrared``, ``flatbed``, ``color``. Unknown
+          values are ignored.
 
         * ``any_capabilities`` (``as``)
 
           Only offer scanners that have at least one of these capabilities,
           with the same values. It is applied together with
           ``required_capabilities``. An application for documents asks for
-          ``['flatbed', 'adf']``, one for film for ``film`` in
+          ``['flatbed', 'feeder']``, one for film for ``film`` in
           ``required_capabilities``, and neither is offered the other's
           scanners. A flatbed with a transparency unit has both, and is
           offered to both.
@@ -145,13 +146,9 @@
 
         * ``type`` (``s``)
 
-          What the device is, in the portal's words: ``scanner``, ``film``
-          for a scanner that is only for film, ``camera`` or ``virtual`` for
-          what is not a scanner at all. Use it to hide devices that are not
-          scanners. It is not the driver's own device type, which differs
-          between drivers and can hold an address; ``capabilities`` says
-          what a scanner can do. The portal leaves cameras out of its lists
-          itself, so ``camera`` is for a future driver.
+          Possible values: ``scanner``, ``film`` (a scanner that is only for
+          film) and ``other`` (a device that is not a scanner, such as a
+          camera). New values may be added in the future.
 
         * ``capabilities`` (``as``)
 
diff --git a/data/scanner-devices.json b/data/scanner-devices.json
index a46f26a..fbfc0e4 100644
--- a/data/scanner-devices.json
+++ b/data/scanner-devices.json
@@ -1,5 +1,5 @@
 {
-  "_comment": "What the scanner portal knows about scanners that SANE does not say. A scanner is matched by its USB id (exact) or by a lower case part of 'vendor model' (a product line). The first match in the list wins, USB ids before product lines. Capabilities: film, infrared, flatbed, adf, color. A scanner that is not named here and is not film by its driver's type is assumed to be for documents. A flatbed with a transparency unit has both film and flatbed. An entry can also name a driver, which is then the one that opens the scanner when it is among the drivers that found it, ahead of any rank.",
+  "_comment": "What the scanner portal knows about scanners that SANE does not say. A scanner is matched by its USB id (exact) or by a lower case part of 'vendor model' (a product line). The first match in the list wins, USB ids before product lines. Capabilities: film, infrared, flatbed, feeder, color. A scanner that is not named here and is not film by its driver's type is assumed to be for documents. A flatbed with a transparency unit has both film and flatbed. An entry can also name a driver, which is then the one that opens the scanner when it is among the drivers that found it, ahead of any rank.",
   "version": 1,
   "scanners": [
     {"usb_id": "07b3:1825", "name": "Plustek OpticFilm 8200i SE", "driver": "plustek8200i", "capabilities": ["film", "infrared", "color"]},
diff --git a/desktop-portal/scanner-helper.c b/desktop-portal/scanner-helper.c
index 3091f28..20f92d9 100644
--- a/desktop-portal/scanner-helper.c
+++ b/desktop-portal/scanner-helper.c
@@ -65,7 +65,7 @@ scanner_capabilities (const char *type)
   if (strstr (t, "flatbed") || strstr (t, "multi-function") || strstr (t, "all-in-one"))
     g_ptr_array_add (caps, "flatbed");
   if (strstr (t, "sheet") || strstr (t, "adf"))
-    g_ptr_array_add (caps, "adf");
+    g_ptr_array_add (caps, "feeder");
   g_ptr_array_add (caps, NULL);
 
   return (const char **) g_ptr_array_free (caps, FALSE);
diff --git a/desktop-portal/scanner.c b/desktop-portal/scanner.c
index a2efcff..fe37e68 100644
--- a/desktop-portal/scanner.c
+++ b/desktop-portal/scanner.c
@@ -468,8 +468,9 @@ scanner_buttons_for (const ScannerTable *table,
 }
 
 /* What kind of device it is, in the portal's words: `film` for a scanner that is only for film,
- * `camera` and `virtual` for what is not a scanner, `scanner` for the rest. The driver's own type
- * says little and differs between drivers; the capabilities are the portal's. */
+ * `other` for what is not a scanner, such as a camera or SANE's test device, `scanner` for the
+ * rest. The driver's own type says little and differs between drivers; the capabilities are the
+ * portal's. */
 static const char *
 scanner_portal_type (const char         *raw,
                      const char * const *capabilities)
@@ -477,14 +478,14 @@ scanner_portal_type (const char         *raw,
   g_autofree char *lower = g_ascii_strdown (raw != NULL ? raw : "", -1);
 
   if (strstr (lower, "camera") != NULL || strstr (lower, "webcam") != NULL)
-    return "camera";
+    return "other";
   if (strstr (lower, "virtual") != NULL)
-    return "virtual";
+    return "other";
 
   if (capabilities != NULL &&
       g_strv_contains (capabilities, "film") &&
       !g_strv_contains (capabilities, "flatbed") &&
-      !g_strv_contains (capabilities, "adf"))
+      !g_strv_contains (capabilities, "feeder"))
     return "film";
 
   return "scanner";
@@ -535,7 +536,7 @@ scanner_device_new_from_helper (const char *id,
    * rest, such as a network scanner whose driver says nothing, are flatbeds or sheet feeders. */
   if (!g_ptr_array_find_with_equal_func (caps, "film", g_str_equal, NULL) &&
       !g_ptr_array_find_with_equal_func (caps, "flatbed", g_str_equal, NULL) &&
-      !g_ptr_array_find_with_equal_func (caps, "adf", g_str_equal, NULL))
+      !g_ptr_array_find_with_equal_func (caps, "feeder", g_str_equal, NULL))
     g_ptr_array_add (caps, g_strdup ("flatbed"));
   g_ptr_array_add (caps, NULL);
 
@@ -1185,7 +1186,7 @@ scanner_enumerate_fake (void)
 {
   GPtrArray *devices = g_ptr_array_new_with_free_func ((GDestroyNotify) scanner_device_free);
   static const char * const film[] = { "film", "infrared", "color", NULL };
-  static const char * const mfp[] = { "flatbed", "adf", "color", NULL };
+  static const char * const mfp[] = { "flatbed", "feeder", "color", NULL };
 
   g_ptr_array_add (devices,
                    scanner_device_new ("fake-film", "Fake Film Scanner", "usb",
