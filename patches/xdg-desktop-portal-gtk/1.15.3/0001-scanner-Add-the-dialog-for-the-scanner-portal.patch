new file mode 100644
index 0000000..1d96b40
--- /dev/null
+++ b/src/scanner.c
@@ -0,0 +1,221 @@
+/*
+ * scanner.c
+ *
+ * Copyright © 2026 Christian Schaller
+ *
+ * This library is free software; you can redistribute it and/or
