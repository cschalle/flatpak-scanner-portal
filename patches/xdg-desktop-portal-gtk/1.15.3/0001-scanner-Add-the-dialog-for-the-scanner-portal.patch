+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+
+#define _GNU_SOURCE 1
+
+#include "config.h"
+
+#include <gio/gio.h>
+#include <gtk/gtk.h>
+
+#include "xdg-desktop-portal-dbus.h"
+
+#include "scanner.h"
+#include "scannerdialog.h"
+#include "request.h"
+#include "utils.h"
+#include "externalwindow.h"
+
+typedef struct {
+  XdpImplScanner *impl;
+  GDBusMethodInvocation *invocation;
+  Request *request;
+
+  GtkWidget *dialog;
+  ExternalWindow *external_parent;
+
+  int response;
+} ScannerDialogHandle;
+
+static void
+scanner_dialog_handle_free (gpointer data)
+{
+  ScannerDialogHandle *handle = data;
+
+  g_clear_object (&handle->external_parent);
+  g_object_unref (handle->request);
+  g_object_unref (handle->dialog);
+
+  g_free (handle);
+}
+
+static void
+scanner_dialog_handle_close (ScannerDialogHandle *handle)
+{
+  gtk_widget_destroy (handle->dialog);
+  scanner_dialog_handle_free (handle);
+}
+
+static void
+send_response (ScannerDialogHandle *handle)
+{
+  GVariantBuilder opt_builder;
+
+  g_variant_builder_init (&opt_builder, G_VARIANT_TYPE_VARDICT);
+
+  if (handle->response == 0)
+    {
+      g_auto(GStrv) selected = scanner_dialog_get_selected (SCANNER_DIALOG (handle->dialog));
+
+      g_variant_builder_add (&opt_builder, "{sv}", "scanners",
+                             g_variant_new_strv ((const char * const *) selected, -1));
+    }
+
+  if (handle->request->exported)
+    request_unexport (handle->request);
+
+  xdp_impl_scanner_complete_select_scanners (handle->impl,
+                                             handle->invocation,
+                                             handle->response,
+                                             g_variant_builder_end (&opt_builder));
+
+  scanner_dialog_handle_close (handle);
+}
+
+static void
+scanner_dialog_done (GtkWidget *widget,
+                     int        response,
+                     gpointer   user_data)
+{
+  ScannerDialogHandle *handle = user_data;
+
+  switch (response)
+    {
+    default:
+      g_warning ("Unexpected response: %d", response);
+      handle->response = 2;
+      break;
+
+    case GTK_RESPONSE_DELETE_EVENT:
+    case GTK_RESPONSE_CANCEL:
+      handle->response = 1;
+      break;
+
+    case GTK_RESPONSE_OK:
+      handle->response = 0;
+      break;
+    }
+
+  send_response (handle);
+}
+
+/* The frontend answers a request that was closed itself, so the dialog goes away without an
+ * answer from here. */
+static gboolean
+handle_close (XdpImplRequest        *object,
+              GDBusMethodInvocation *invocation,
+              ScannerDialogHandle   *handle)
+{
+  scanner_dialog_handle_close (handle);
+
+  return FALSE;
+}
+
+static gboolean
+handle_select_scanners (XdpImplScanner        *object,
+                        GDBusMethodInvocation *invocation,
+                        const char            *arg_handle,
+                        const char            *arg_parent_window,
+                        const char            *arg_app_id,
+                        GVariant              *arg_scanners,
+                        GVariant              *arg_options)
+{
+  g_autoptr(Request) request = NULL;
+  const char *sender;
+  ScannerDialogHandle *handle;
+  GtkWidget *dialog;
+  GdkDisplay *display;
+  GdkScreen *screen;
+  ExternalWindow *external_parent = NULL;
+  GtkWidget *fake_parent;
+
+  sender = g_dbus_method_invocation_get_sender (invocation);
+
+  request = request_new (sender, arg_app_id, arg_handle);
+
+  if (arg_parent_window && *arg_parent_window)
+    {
+      external_parent = create_external_window_from_handle (arg_parent_window);
+      if (!external_parent)
+        g_warning ("Failed to associate portal window with parent window %s",
+                   arg_parent_window);
+    }
+
+  if (external_parent)
+    display = external_window_get_display (external_parent);
+  else
+    display = gdk_display_get_default ();
+  screen = gdk_display_get_default_screen (display);
+
+  fake_parent = g_object_new (GTK_TYPE_WINDOW,
+                              "type", GTK_WINDOW_TOPLEVEL,
+                              "screen", screen,
+                              NULL);
+  g_object_ref_sink (fake_parent);
+
+  dialog = GTK_WIDGET (scanner_dialog_new (arg_app_id, arg_scanners, arg_options));
+  gtk_window_set_transient_for (GTK_WINDOW (dialog), GTK_WINDOW (fake_parent));
+
+  handle = g_new0 (ScannerDialogHandle, 1);
+  handle->impl = object;
+  handle->invocation = invocation;
+  handle->request = g_object_ref (request);
+  handle->dialog = g_object_ref (dialog);
+  handle->external_parent = external_parent;
+  handle->response = 2;
+
+  g_signal_connect (request, "handle-close", G_CALLBACK (handle_close), handle);
+
+  g_signal_connect (dialog, "done", G_CALLBACK (scanner_dialog_done), handle);
+
+  gtk_widget_realize (dialog);
+
+  if (external_parent)
+    external_window_set_parent_of (external_parent, gtk_widget_get_window (dialog));
+
+  gtk_widget_show (dialog);
+
+  request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  return TRUE;
+}
+
+gboolean
+scanner_init (GDBusConnection  *bus,
+              GError          **error)
+{
+  GDBusInterfaceSkeleton *helper;
+
+  helper = G_DBUS_INTERFACE_SKELETON (xdp_impl_scanner_skeleton_new ());
+
+  g_signal_connect (helper, "handle-select-scanners", G_CALLBACK (handle_select_scanners), NULL);
+
+  xdp_impl_scanner_set_version (XDP_IMPL_SCANNER (helper), 1);
+
+  if (!g_dbus_interface_skeleton_export (helper,
+                                         bus,
+                                         DESKTOP_PORTAL_OBJECT_PATH,
+                                         error))
+    return FALSE;
+
+  g_debug ("providing %s", g_dbus_interface_skeleton_get_info (helper)->name);
+
+  return TRUE;
+}
