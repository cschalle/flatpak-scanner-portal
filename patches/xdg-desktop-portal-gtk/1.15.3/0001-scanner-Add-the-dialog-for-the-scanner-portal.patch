diff --git a/src/scannerdialog.c b/src/scannerdialog.c
new file mode 100644
index 0000000..640e2e9
--- /dev/null
+++ b/src/scannerdialog.c
@@ -0,0 +1,470 @@
+/*
+ * scannerdialog.c
+ *
+ * Copyright © 2026 Christian Schaller
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#define _GNU_SOURCE 1
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gio/gio.h>
+#include <gio/gdesktopappinfo.h>
+#include <glib/gi18n.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "scannerdialog.h"
+
+struct _ScannerDialog {
+  GtkWindow parent;
+
+  GtkWidget *accept_button;
+  GtkWidget *scanner_list;
+  GtkWidget *heading;
+  GtkWidget *subheading;
+  GtkWidget *stack;
+
+  /* The check button of every row that can be chosen, in list order */
+  GPtrArray *choices;
+  gboolean multiple;
+};
+
+struct _ScannerDialogClass {
+  GtkWindowClass parent_class;
+};
+
+enum {
+  DONE,
+  LAST_SIGNAL
+};
+
+static guint signals[LAST_SIGNAL];
+
+G_DEFINE_TYPE (ScannerDialog, scanner_dialog, GTK_TYPE_WINDOW)
+
+#define SCANNER_ID_KEY "scanner-id"
+
+static void
+update_accept_button (ScannerDialog *dialog)
+{
+  gboolean any = FALSE;
+
+  for (guint i = 0; i < dialog->choices->len; i++)
+    {
+      GtkToggleButton *choice = g_ptr_array_index (dialog->choices, i);
+
+      if (gtk_toggle_button_get_active (choice))
+        {
+          any = TRUE;
+          break;
+        }
+    }
+
+  gtk_widget_set_sensitive (dialog->accept_button, any);
+}
+
+static void
+choice_toggled (GtkToggleButton *choice,
+                ScannerDialog   *dialog)
+{
+  update_accept_button (dialog);
+}
+
+/* A click anywhere on a row that can be chosen chooses it */
+static void
+row_activated (GtkListBox    *list,
+               GtkListBoxRow *row,
+               ScannerDialog *dialog)
+{
+  GtkWidget *choice = g_object_get_data (G_OBJECT (row), "choice");
+
+  if (choice && gtk_widget_get_sensitive (choice))
+    gtk_button_clicked (GTK_BUTTON (choice));
+}
+
+static void
+finish (ScannerDialog *dialog,
+        int            response)
+{
+  gtk_widget_hide (GTK_WIDGET (dialog));
+  g_signal_emit (dialog, signals[DONE], 0, response);
+}
+
+static void
+button_clicked (GtkWidget     *button,
+                ScannerDialog *dialog)
+{
+  finish (dialog, button == dialog->accept_button ? GTK_RESPONSE_OK : GTK_RESPONSE_CANCEL);
+}
+
+/* Escape cancels and Return chooses, whichever control has the focus: a radio button would
+ * otherwise take Return itself. */
+static gboolean
+scanner_dialog_key_press_event (GtkWidget   *widget,
+                                GdkEventKey *event)
+{
+  ScannerDialog *dialog = SCANNER_DIALOG (widget);
+
+  if (event->keyval == GDK_KEY_Escape)
+    {
+      finish (dialog, GTK_RESPONSE_CANCEL);
+      return GDK_EVENT_STOP;
+    }
+
+  if ((event->keyval == GDK_KEY_Return || event->keyval == GDK_KEY_KP_Enter) &&
+      gtk_widget_get_sensitive (dialog->accept_button))
+    {
+      finish (dialog, GTK_RESPONSE_OK);
+      return GDK_EVENT_STOP;
+    }
+
+  return GTK_WIDGET_CLASS (scanner_dialog_parent_class)->key_press_event (widget, event);
+}
+
+static gboolean
+scanner_dialog_delete_event (GtkWidget   *widget,
+                             GdkEventAny *event)
+{
+  finish (SCANNER_DIALOG (widget), GTK_RESPONSE_CANCEL);
+
+  return TRUE;
+}
+
+static void
+scanner_dialog_finalize (GObject *object)
+{
+  ScannerDialog *dialog = SCANNER_DIALOG (object);
+
+  g_clear_pointer (&dialog->choices, g_ptr_array_unref);
+
+  G_OBJECT_CLASS (scanner_dialog_parent_class)->finalize (object);
+}
+
+static void
+scanner_dialog_class_init (ScannerDialogClass *class)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (class);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (class);
+
+  object_class->finalize = scanner_dialog_finalize;
+  widget_class->key_press_event = scanner_dialog_key_press_event;
+  widget_class->delete_event = scanner_dialog_delete_event;
+
+  signals[DONE] = g_signal_new ("done",
+                                G_TYPE_FROM_CLASS (class),
+                                G_SIGNAL_RUN_LAST,
+                                0,
+                                NULL, NULL,
+                                NULL,
+                                G_TYPE_NONE, 1,
+                                G_TYPE_INT);
+
+  gtk_widget_class_set_template_from_resource (widget_class, "/org/freedesktop/portal/desktop/gtk/scannerdialog.ui");
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, accept_button);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, scanner_list);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, heading);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, subheading);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, stack);
+  gtk_widget_class_bind_template_callback (widget_class, button_clicked);
+  gtk_widget_class_bind_template_callback (widget_class, row_activated);
+}
+
+static void
+scanner_dialog_init (ScannerDialog *dialog)
+{
+  dialog->choices = g_ptr_array_new ();
+
+  gtk_widget_init_template (GTK_WIDGET (dialog));
+}
+
+static char *
+get_app_display_name (const char *app_id)
+{
+  g_autoptr(GAppInfo) info = NULL;
+  g_autofree char *id = NULL;
+
+  if (!app_id || *app_id == '\0')
+    return NULL;
+
+  id = g_strconcat (app_id, ".desktop", NULL);
+  info = G_APP_INFO (g_desktop_app_info_new (id));
+  if (info)
+    return g_strdup (g_app_info_get_display_name (info));
+
+  return g_strdup (app_id);
+}
+
+/* What the scanner is and how it is connected, from the hints the portal gives. The name of the
+ * scanner comes from the driver and is shown as it is. */
+static char *
+describe_scanner (const char  *kind,
+                  const char  *type,
+                  const char **capabilities,
+                  gboolean     available)
+{
+  g_autoptr(GPtrArray) parts = g_ptr_array_new_with_free_func (g_free);
+
+  if (g_strcmp0 (kind, "usb") == 0)
+    g_ptr_array_add (parts, g_strdup (_("USB")));
+  else if (g_strcmp0 (kind, "network") == 0)
+    g_ptr_array_add (parts, g_strdup (_("Network")));
+
+  /* Every kind of glass the scanner has, since a multi-function device has two */
+  if (g_strv_contains (capabilities, "film") ||
+      g_strv_contains (capabilities, "flatbed") ||
+      g_strv_contains (capabilities, "adf"))
+    {
+      g_autoptr(GPtrArray) sources = g_ptr_array_new ();
+
+      if (g_strv_contains (capabilities, "flatbed"))
+        g_ptr_array_add (sources, (gpointer) _("Flatbed"));
+      if (g_strv_contains (capabilities, "adf"))
+        g_ptr_array_add (sources, (gpointer) _("Feeder"));
+      if (g_strv_contains (capabilities, "film"))
+        g_ptr_array_add (sources, (gpointer) _("Film"));
+      g_ptr_array_add (sources, NULL);
+
+      g_ptr_array_add (parts, g_strjoinv (" + ", (char **) sources->pdata));
+    }
+  else if (type && *type && g_strcmp0 (type, "virtual device") != 0)
+    g_ptr_array_add (parts, g_strdup (type));
+
+  if (!available)
+    g_ptr_array_add (parts, g_strdup (_("Not available")));
+
+  g_ptr_array_add (parts, NULL);
+
+  return g_strjoinv (" · ", (char **) parts->pdata);
+}
+
+static void
+add_scanner_row (ScannerDialog  *dialog,
+                 const char     *id,
+                 GVariant       *info,
+                 GtkRadioButton **first)
+{
+  g_autoptr(GVariantDict) dict = g_variant_dict_new (info);
+  g_autofree const char **capabilities = NULL;
+  g_autofree char *subtitle = NULL;
+  g_autofree char *title = NULL;
+  const char *name = NULL;
+  const char *vendor = NULL;
+  const char *model = NULL;
+  const char *kind = NULL;
+  const char *type = NULL;
+  gboolean available = TRUE;
+  GtkWidget *row;
+  GtkWidget *box;
+  GtkWidget *icon;
+  GtkWidget *texts;
+  GtkWidget *label;
+  GtkWidget *choice;
+  AtkObject *atk;
+
+  g_variant_dict_lookup (dict, "name", "&s", &name);
+  g_variant_dict_lookup (dict, "vendor", "&s", &vendor);
+  g_variant_dict_lookup (dict, "model", "&s", &model);
+  g_variant_dict_lookup (dict, "kind", "&s", &kind);
+  g_variant_dict_lookup (dict, "type", "&s", &type);
+  g_variant_dict_lookup (dict, "available", "b", &available);
+  g_variant_dict_lookup (dict, "capabilities", "^a&s", &capabilities);
+
+  if (name && *name)
+    title = g_strdup (name);
+  else if (vendor && model)
+    title = g_strdup_printf ("%s %s", vendor, model);
+  else
+    title = g_strdup (_("Unknown scanner"));
+
+  subtitle = describe_scanner (kind, type, capabilities ? capabilities : (const char *[]) { NULL }, available);
+
+  box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  gtk_widget_set_margin_start (box, 12);
+  gtk_widget_set_margin_end (box, 12);
+  gtk_widget_set_margin_top (box, 8);
+  gtk_widget_set_margin_bottom (box, 8);
+
+  icon = gtk_image_new_from_icon_name ("scanner-symbolic", GTK_ICON_SIZE_LARGE_TOOLBAR);
+  gtk_box_pack_start (GTK_BOX (box), icon, FALSE, FALSE, 0);
+
+  texts = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_widget_set_valign (texts, GTK_ALIGN_CENTER);
+  gtk_box_pack_start (GTK_BOX (box), texts, TRUE, TRUE, 0);
+
+  label = gtk_label_new (title);
+  gtk_label_set_xalign (GTK_LABEL (label), 0);
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+  gtk_box_pack_start (GTK_BOX (texts), label, FALSE, FALSE, 0);
+
+  if (*subtitle)
+    {
+      label = gtk_label_new (subtitle);
+      gtk_label_set_xalign (GTK_LABEL (label), 0);
+      gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+      gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+      gtk_box_pack_start (GTK_BOX (texts), label, FALSE, FALSE, 0);
+    }
+
+  /* One choice at most unless the application can use several: radio behaviour */
+  if (dialog->multiple)
+    choice = gtk_check_button_new ();
+  else
+    choice = gtk_radio_button_new_from_widget (*first);
+  gtk_widget_set_valign (choice, GTK_ALIGN_CENTER);
+  gtk_box_pack_end (GTK_BOX (box), choice, FALSE, FALSE, 0);
+
+  /* The control has no text of its own, so a screen reader needs the scanner's name on it */
+  atk = gtk_widget_get_accessible (choice);
+  atk_object_set_name (atk, title);
+  atk_object_set_description (atk, subtitle);
+
+  g_object_set_data_full (G_OBJECT (choice), SCANNER_ID_KEY, g_strdup (id), g_free);
+
+  row = gtk_list_box_row_new ();
+  gtk_container_add (GTK_CONTAINER (row), box);
+  gtk_widget_set_can_focus (row, FALSE);
+  g_object_set_data (G_OBJECT (row), "choice", choice);
+
+  if (!available)
+    {
+      /* Only the control is dimmed. The text says why the scanner cannot be chosen, so it stays
+       * at the contrast of the other rows, which matters most in high contrast. */
+      gtk_widget_set_sensitive (choice, FALSE);
+      gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), FALSE);
+    }
+  else
+    {
+      if (!dialog->multiple && !*first)
+        *first = GTK_RADIO_BUTTON (choice);
+
+      g_signal_connect (choice, "toggled", G_CALLBACK (choice_toggled), dialog);
+      g_ptr_array_add (dialog->choices, choice);
+    }
+
+  gtk_widget_show_all (row);
+  gtk_list_box_insert (GTK_LIST_BOX (dialog->scanner_list), row, -1);
+}
+
+ScannerDialog *
+scanner_dialog_new (const char *app_id,
+                    GVariant   *scanners,
+                    GVariant   *options)
+{
+  g_autoptr(GVariantDict) opts = g_variant_dict_new (options);
+  g_autofree char *app_name = NULL;
+  g_autofree char *heading = NULL;
+  GtkRadioButton *first = NULL;
+  guint n_rows = 0;
+  const char *accept_label = NULL;
+  const char *title = NULL;
+  gboolean modal = TRUE;
+  GVariantIter iter;
+  GVariant *info;
+  const char *id;
+  ScannerDialog *dialog;
+
+  dialog = g_object_new (SCANNER_TYPE_DIALOG, NULL);
+
+  g_variant_dict_lookup (opts, "multiple", "b", &dialog->multiple);
+  g_variant_dict_lookup (opts, "modal", "b", &modal);
+  g_variant_dict_lookup (opts, "accept_label", "&s", &accept_label);
+  g_variant_dict_lookup (opts, "title", "&s", &title);
+
+  gtk_window_set_modal (GTK_WINDOW (dialog), modal);
+  gtk_window_set_title (GTK_WINDOW (dialog), dialog->multiple ? _("Select Scanners") : _("Select Scanner"));
+  gtk_header_bar_set_title (GTK_HEADER_BAR (gtk_window_get_titlebar (GTK_WINDOW (dialog))),
+                            dialog->multiple ? _("Select Scanners") : _("Select Scanner"));
+
+  if (accept_label && *accept_label)
+    {
+      gtk_button_set_label (GTK_BUTTON (dialog->accept_button), accept_label);
+      gtk_button_set_use_underline (GTK_BUTTON (dialog->accept_button), TRUE);
+    }
+
+  app_name = get_app_display_name (app_id);
+  if (app_name)
+    heading = dialog->multiple ? g_strdup_printf (_("%s wants to use the following scanners"), app_name)
+                               : g_strdup_printf (_("%s wants to use a scanner"), app_name);
+  else
+    heading = g_strdup (dialog->multiple ? _("An app wants to use the following scanners")
+                                         : _("An app wants to use a scanner"));
+  gtk_label_set_label (GTK_LABEL (dialog->heading), heading);
+
+  /* The application's own words, kept apart from the heading, which is the portal's */
+  if (title && *title)
+    {
+      gtk_label_set_label (GTK_LABEL (dialog->subheading), title);
+      gtk_label_set_ellipsize (GTK_LABEL (dialog->subheading), PANGO_ELLIPSIZE_END);
+      gtk_label_set_lines (GTK_LABEL (dialog->subheading), 2);
+      gtk_widget_show (dialog->subheading);
+    }
+
+  g_variant_iter_init (&iter, scanners);
+  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
+    {
+      add_scanner_row (dialog, id, info, &first);
+      n_rows++;
+      g_variant_unref (info);
+    }
+
+  /* The first scanner that can be used is chosen already, so that one click is enough in the
+   * common case of one scanner. */
+  if (dialog->choices->len > 0)
+    {
+      GtkWidget *preselected = g_ptr_array_index (dialog->choices, 0);
+
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (preselected), TRUE);
+      gtk_window_set_focus (GTK_WINDOW (dialog), preselected);
+    }
+  else
+    gtk_stack_set_visible_child_name (GTK_STACK (dialog->stack), "empty-state");
+
+  update_accept_button (dialog);
+
+  /* Size the window to the list: room for the heading and the header bar, a row each, and no
+   * more than about what fits on a small screen. */
+  {
+    int height = n_rows > 0 ? 190 + (int) n_rows * 60 : 320;
+
+    gtk_window_set_default_size (GTK_WINDOW (dialog), 500, CLAMP (height, 280, 600));
+  }
+
+  return dialog;
+}
+
+char **
+scanner_dialog_get_selected (ScannerDialog *dialog)
+{
+  GStrvBuilder *builder = g_strv_builder_new ();
+  char **selected;
+
+  g_return_val_if_fail (dialog != NULL, NULL);
+
+  for (guint i = 0; i < dialog->choices->len; i++)
+    {
+      GtkToggleButton *choice = g_ptr_array_index (dialog->choices, i);
+
+      if (gtk_toggle_button_get_active (choice))
+        g_strv_builder_add (builder, g_object_get_data (G_OBJECT (choice), SCANNER_ID_KEY));
+    }
+
+  selected = g_strv_builder_end (builder);
+  g_strv_builder_unref (builder);
+
+  return selected;
+}
