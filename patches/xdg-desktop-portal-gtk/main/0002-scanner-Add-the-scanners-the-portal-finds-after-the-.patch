   G_OBJECT_CLASS (scanner_dialog_parent_class)->finalize (object);
 }
@@ -180,6 +187,7 @@ scanner_dialog_class_init (ScannerDialogClass *class)
   gtk_widget_class_bind_template_child (widget_class, ScannerDialog, heading);
   gtk_widget_class_bind_template_child (widget_class, ScannerDialog, subheading);
   gtk_widget_class_bind_template_child (widget_class, ScannerDialog, stack);
