 };
 
 struct _ScannerDialogClass {
@@ -151,6 +157,7 @@ scanner_dialog_finalize (GObject *object)
   ScannerDialog *dialog = SCANNER_DIALOG (object);
 
   g_clear_pointer (&dialog->choices, g_ptr_array_unref);
