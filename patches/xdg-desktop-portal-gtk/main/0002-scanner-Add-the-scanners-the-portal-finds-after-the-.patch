   gtk_widget_class_bind_template_callback (widget_class, button_clicked);
   gtk_widget_class_bind_template_callback (widget_class, row_activated);
 }
@@ -188,6 +196,7 @@ static void
 scanner_dialog_init (ScannerDialog *dialog)
 {
   dialog->choices = g_ptr_array_new ();
+  dialog->known = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
 
   gtk_widget_init_template (GTK_WIDGET (dialog));
 }
@@ -253,10 +262,9 @@ describe_scanner (const char  *kind,
 }
 
 static void
-add_scanner_row (ScannerDialog  *dialog,
-                 const char     *id,
-                 GVariant       *info,
-                 GtkRadioButton **first)
+add_scanner_row (ScannerDialog *dialog,
+                 const char    *id,
+                 GVariant      *info)
 {
   g_autoptr(GVariantDict) dict = g_variant_dict_new (info);
   g_autofree const char **capabilities = NULL;
@@ -324,7 +332,7 @@ add_scanner_row (ScannerDialog  *dialog,
   if (dialog->multiple)
     choice = gtk_check_button_new ();
   else
-    choice = gtk_radio_button_new_from_widget (*first);
+    choice = gtk_radio_button_new_from_widget (dialog->first_choice);
   gtk_widget_set_valign (choice, GTK_ALIGN_CENTER);
   gtk_box_pack_end (GTK_BOX (box), choice, FALSE, FALSE, 0);
 
@@ -349,8 +357,8 @@ add_scanner_row (ScannerDialog  *dialog,
     }
   else
     {
-      if (!dialog->multiple && !*first)
-        *first = GTK_RADIO_BUTTON (choice);
+      if (!dialog->multiple && !dialog->first_choice)
+        dialog->first_choice = GTK_RADIO_BUTTON (choice);
 
       g_signal_connect (choice, "toggled", G_CALLBACK (choice_toggled), dialog);
       g_ptr_array_add (dialog->choices, choice);
@@ -360,6 +368,73 @@ add_scanner_row (ScannerDialog  *dialog,
   gtk_list_box_insert (GTK_LIST_BOX (dialog->scanner_list), row, -1);
 }
 
+/* Shows what the stack should: the rows if there are any, else that the search is on, else that
+ * there is nothing */
+static void
+update_stack (ScannerDialog *dialog)
+{
+  const char *page = "scanners";
+
+  if (dialog->choices->len == 0 && g_hash_table_size (dialog->known) == 0)
+    page = dialog->searching ? "searching" : "empty-state";
+
+  gtk_stack_set_visible_child_name (GTK_STACK (dialog->stack), page);
+  gtk_widget_set_visible (dialog->searching_box,
+                          dialog->searching && g_hash_table_size (dialog->known) > 0);
+}
+
+guint
+scanner_dialog_add_scanners (ScannerDialog *dialog,
+                             GVariant      *scanners)
+{
+  GVariantIter iter;
+  GVariant *info;
+  const char *id;
+  guint added = 0;
+  gboolean was_empty;
+
+  g_return_val_if_fail (dialog != NULL, 0);
+
+  was_empty = dialog->choices->len == 0;
+
+  g_variant_iter_init (&iter, scanners);
+  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
+    {
+      if (!g_hash_table_contains (dialog->known, id))
+        {
+          g_hash_table_add (dialog->known, g_strdup (id));
+          add_scanner_row (dialog, id, info);
+          added++;
+        }
+      g_variant_unref (info);
+    }
+
+  /* The first scanner that can be used is chosen already, so that one click is enough in the
+   * common case of one scanner. Later ones do not take the choice from the user. */
+  if (was_empty && dialog->choices->len > 0)
+    {
+      GtkWidget *preselected = g_ptr_array_index (dialog->choices, 0);
+
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (preselected), TRUE);
+      gtk_window_set_focus (GTK_WINDOW (dialog), preselected);
+    }
+
+  update_accept_button (dialog);
+  update_stack (dialog);
+
+  return added;
+}
+
+void
+scanner_dialog_set_searching (ScannerDialog *dialog,
+                              gboolean       searching)
+{
+  g_return_if_fail (dialog != NULL);
+
+  dialog->searching = searching;
+  update_stack (dialog);
+}
+
 ScannerDialog *
 scanner_dialog_new (const char *app_id,
                     GVariant   *scanners,
@@ -368,14 +443,10 @@ scanner_dialog_new (const char *app_id,
   g_autoptr(GVariantDict) opts = g_variant_dict_new (options);
   g_autofree char *app_name = NULL;
   g_autofree char *heading = NULL;
-  GtkRadioButton *first = NULL;
   guint n_rows = 0;
   const char *accept_label = NULL;
   const char *title = NULL;
   gboolean modal = TRUE;
-  GVariantIter iter;
-  GVariant *info;
-  const char *id;
   ScannerDialog *dialog;
 
   dialog = g_object_new (SCANNER_TYPE_DIALOG, NULL);
@@ -384,6 +455,7 @@ scanner_dialog_new (const char *app_id,
   g_variant_dict_lookup (opts, "modal", "b", &modal);
   g_variant_dict_lookup (opts, "accept_label", "&s", &accept_label);
   g_variant_dict_lookup (opts, "title", "&s", &title);
+  g_variant_dict_lookup (opts, "searching", "b", &dialog->searching);
 
   gtk_window_set_modal (GTK_WINDOW (dialog), modal);
   gtk_window_set_title (GTK_WINDOW (dialog), dialog->multiple ? _("Select Scanners") : _("Select Scanner"));
@@ -414,27 +486,8 @@ scanner_dialog_new (const char *app_id,
       gtk_widget_show (dialog->subheading);
     }
 
-  g_variant_iter_init (&iter, scanners);
-  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
-    {
-      add_scanner_row (dialog, id, info, &first);
-      n_rows++;
-      g_variant_unref (info);
-    }
-
-  /* The first scanner that can be used is chosen already, so that one click is enough in the
-   * common case of one scanner. */
-  if (dialog->choices->len > 0)
-    {
-      GtkWidget *preselected = g_ptr_array_index (dialog->choices, 0);
-
-      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (preselected), TRUE);
-      gtk_window_set_focus (GTK_WINDOW (dialog), preselected);
-    }
-  else
-    gtk_stack_set_visible_child_name (GTK_STACK (dialog->stack), "empty-state");
-
-  update_accept_button (dialog);
+  n_rows = scanner_dialog_add_scanners (dialog, scanners);
+  scanner_dialog_set_searching (dialog, dialog->searching);
 
   /* Size the window to the list: room for the heading and the header bar, a row each, and no
    * more than about what fits on a small screen. */
diff --git a/src/scannerdialog.h b/src/scannerdialog.h
index 086c8d8..ad4f0f4 100644
--- a/src/scannerdialog.h
+++ b/src/scannerdialog.h
@@ -33,5 +33,15 @@ ScannerDialog *scanner_dialog_new (const char *app_id,
                                    GVariant   *scanners,
                                    GVariant   *options);
 
+/* Adds the scanners that have no row yet, a(sa{sv}) as in the portal's calls, and returns how
+ * many rows that made. The first scanner that can be chosen is chosen, if none was. */
+guint scanner_dialog_add_scanners (ScannerDialog *dialog,
+                                   GVariant      *scanners);
+
+/* Whether more scanners may still come, which the dialog says and which keeps it from telling
+ * the user that there are none */
+void scanner_dialog_set_searching (ScannerDialog *dialog,
+                                   gboolean       searching);
+
 /* The ids of the scanners the user chose, NULL-terminated; free with g_strfreev () */
 char **scanner_dialog_get_selected (ScannerDialog *dialog);
