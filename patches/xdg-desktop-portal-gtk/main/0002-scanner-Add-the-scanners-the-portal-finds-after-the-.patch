From 2113667afa5d0851519878be0c49ca9538eed4f9 Mon Sep 17 00:00:00 2001
From: "Christian F.K. Schaller" <christian.schaller@gmail.com>
Date: Mon, 26 Oct 2026 18:17:13 -0400
Subject: [PATCH] scanner: Add the scanners the portal finds after the dialog
 is shown
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This commit makes the dialog take scanners after it is on screen, for
the portal that shows the dialog before its search is over. The new
UpdateScanners call adds rows for the scanners it carries, none twice,
and says whether the search goes on. SelectScanners sets `searching`
in its options when it does.

While the search goes on and there is no row yet, the dialog shows
"Searching for Scanners…" with a spinner, and not "No Scanners
Found", which it shows once the search is over and found nothing.
Once there are rows, a spinner with "Searching for scanners…" sits
below them until the search ends. The first scanner that can be used
is chosen when it appears, if none was, and later ones do not take the
choice from the user.

The backend keeps its open dialogs by the handle of the request, and
drops a dialog when it is closed or answered, so an UpdateScanners
call that comes after that does nothing and still gets its reply.

The copy of the interface description is the one of the portal.

Tested on main: it builds without errors. On a private bus with a
headless mutter and the frontend built from main, the dialog opened
with the search going on, took two scanners and the end of the search
two seconds later, and closed on Request.Close. The look of the rows
and of the spinner is not checked by a test.
---
 data/org.freedesktop.impl.portal.Scanner.xml |  27 ++++-
 src/scanner.c                                |  34 ++++++
 src/scannerdialog.c                          | 117 ++++++++++++++-----
 src/scannerdialog.h                          |  10 ++
 src/scannerdialog.ui                         |  71 +++++++++++
 5 files changed, 226 insertions(+), 33 deletions(-)

diff --git a/data/org.freedesktop.impl.portal.Scanner.xml b/data/org.freedesktop.impl.portal.Scanner.xml
index 4ce64c9..a8cd75d 100644
--- a/data/org.freedesktop.impl.portal.Scanner.xml
+++ b/data/org.freedesktop.impl.portal.Scanner.xml
@@ -32,7 +32,14 @@
 
         * ``scanners`` (``as``)
 
-          The ids chosen from @scanners. The frontend stores the grant.
+          The ids chosen from @scanners. The frontend keeps the grant in memory.
+
+        The frontend does not wait for every driver before it calls this. Finding the
+        scanners can take seconds, mostly for the ones on the network, while a scanner on USB
+        is found at once. If the frontend is still looking, @options has ``searching`` (``b``)
+        set to true, @scanners is what was found so far, possibly nothing, and the rest comes
+        with :ref:`org.freedesktop.impl.portal.Scanner.UpdateScanners`. The dialog should show
+        what it has, and that it is still looking.
     -->
     <method name="SelectScanners">
       <arg type="o" name="handle" direction="in"/>
@@ -46,6 +53,24 @@
       <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
       <arg type="a{sv}" name="results" direction="out"/>
     </method>
+    <!--
+        UpdateScanners:
+        @handle: Object path of the Request of the SelectScanners call
+        @scanners: Array of scanner id and information vardict for the scanners found since
+        the last call, in the format of the @scanners of SelectScanners
+        @searching: Whether the frontend is still looking for scanners
+
+        Adds scanners to a dialog that SelectScanners showed with ``searching`` set, as
+        the frontend finds them. The last call has @searching false, possibly with no scanners.
+        Calls for a @handle that is not showing a dialog are ignored. Scanners from earlier
+        calls are not repeated.
+    -->
+    <method name="UpdateScanners">
+      <arg type="o" name="handle" direction="in"/>
+      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QList&lt;QPair&lt;QString,QVariantMap&gt;&gt;"/>
+      <arg type="a(sa{sv})" name="scanners" direction="in"/>
+      <arg type="b" name="searching" direction="in"/>
+    </method>
     <property name="version" type="u" access="read"/>
   </interface>
 </node>
diff --git a/src/scanner.c b/src/scanner.c
index 1d96b40..3073083 100644
--- a/src/scanner.c
+++ b/src/scanner.c
@@ -33,7 +33,11 @@
 #include "utils.h"
 #include "externalwindow.h"
 
+/* The dialogs that are showing, by the handle of their request, for UpdateScanners */
+static GHashTable *dialogs;
+
 typedef struct {
+  char *handle;
   XdpImplScanner *impl;
   GDBusMethodInvocation *invocation;
   Request *request;
@@ -49,10 +53,14 @@ scanner_dialog_handle_free (gpointer data)
 {
   ScannerDialogHandle *handle = data;
 
+  if (dialogs != NULL)
+    g_hash_table_remove (dialogs, handle->handle);
+
   g_clear_object (&handle->external_parent);
   g_object_unref (handle->request);
   g_object_unref (handle->dialog);
 
+  g_free (handle->handle);
   g_free (handle);
 }
 
@@ -174,6 +182,7 @@ handle_select_scanners (XdpImplScanner        *object,
   gtk_window_set_transient_for (GTK_WINDOW (dialog), GTK_WINDOW (fake_parent));
 
   handle = g_new0 (ScannerDialogHandle, 1);
+  handle->handle = g_strdup (arg_handle);
   handle->impl = object;
   handle->invocation = invocation;
   handle->request = g_object_ref (request);
@@ -192,11 +201,34 @@ handle_select_scanners (XdpImplScanner        *object,
 
   gtk_widget_show (dialog);
 
+  g_hash_table_replace (dialogs, g_strdup (arg_handle), handle);
+
   request_export (request, g_dbus_method_invocation_get_connection (invocation));
 
   return TRUE;
 }
 
+static gboolean
+handle_update_scanners (XdpImplScanner        *object,
+                        GDBusMethodInvocation *invocation,
+                        const char            *arg_handle,
+                        GVariant              *arg_scanners,
+                        gboolean               arg_searching)
+{
+  ScannerDialogHandle *handle = g_hash_table_lookup (dialogs, arg_handle);
+
+  /* The dialog may be gone already: the user chose, or the application closed the request */
+  if (handle != NULL)
+    {
+      scanner_dialog_add_scanners (SCANNER_DIALOG (handle->dialog), arg_scanners);
+      scanner_dialog_set_searching (SCANNER_DIALOG (handle->dialog), arg_searching);
+    }
+
+  xdp_impl_scanner_complete_update_scanners (object, invocation);
+
+  return TRUE;
+}
+
 gboolean
 scanner_init (GDBusConnection  *bus,
               GError          **error)
@@ -205,7 +237,9 @@ scanner_init (GDBusConnection  *bus,
 
   helper = G_DBUS_INTERFACE_SKELETON (xdp_impl_scanner_skeleton_new ());
 
+  dialogs = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
   g_signal_connect (helper, "handle-select-scanners", G_CALLBACK (handle_select_scanners), NULL);
+  g_signal_connect (helper, "handle-update-scanners", G_CALLBACK (handle_update_scanners), NULL);
 
   xdp_impl_scanner_set_version (XDP_IMPL_SCANNER (helper), 1);
 
