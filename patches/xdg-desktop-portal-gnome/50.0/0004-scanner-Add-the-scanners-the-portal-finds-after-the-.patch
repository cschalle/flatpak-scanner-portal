   gtk_widget_class_bind_template_callback (widget_class, on_accept_button_clicked_cb);
   gtk_widget_class_bind_template_callback (widget_class, on_cancel_button_clicked_cb);
@@ -157,6 +165,7 @@ static void
 scanner_dialog_init (ScannerDialog *self)
 {
   self->choices = g_ptr_array_new ();
+  self->known = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
 
   gtk_widget_init_template (GTK_WIDGET (self));
 }
@@ -224,8 +233,7 @@ describe_scanner (const char *kind,
 static void
 add_scanner_row (ScannerDialog *self,
                  const char    *id,
-                 GVariant      *info,
-                 GtkCheckButton **first)
+                 GVariant      *info)
 {
   g_autoptr(GVariantDict) dict = g_variant_dict_new (info);
   g_autofree const char **capabilities = NULL;
@@ -295,10 +303,10 @@ add_scanner_row (ScannerDialog *self,
       /* One choice at most unless the application can use several: radio behaviour */
       if (!self->multiple)
         {
-          if (*first)
-            gtk_check_button_set_group (GTK_CHECK_BUTTON (choice), *first);
+          if (self->first_choice)
+            gtk_check_button_set_group (GTK_CHECK_BUTTON (choice), self->first_choice);
           else
-            *first = GTK_CHECK_BUTTON (choice);
+            self->first_choice = GTK_CHECK_BUTTON (choice);
         }
 
       g_signal_connect (choice, "toggled", G_CALLBACK (on_choice_toggled_cb), self);
@@ -308,6 +316,72 @@ add_scanner_row (ScannerDialog *self,
   adw_preferences_group_add (self->scanner_list, row);
 }
 
+/* Shows what the stack should: the rows if there are any, else that the search is on, else that
+ * there is nothing */
+static void
+update_stack (ScannerDialog *self)
+{
+  const char *page = "scanners";
+
+  if (self->choices->len == 0 && g_hash_table_size (self->known) == 0)
+    page = self->searching ? "searching" : "empty-state";
+
+  gtk_stack_set_visible_child_name (GTK_STACK (self->stack), page);
+  gtk_widget_set_visible (self->searching_group, self->searching && g_hash_table_size (self->known) > 0);
+}
+
+guint
+scanner_dialog_add_scanners (ScannerDialog *self,
+                             GVariant      *scanners)
+{
+  GVariantIter iter;
+  GVariant *info;
+  const char *id;
+  guint added = 0;
+  gboolean was_empty;
+
+  g_return_val_if_fail (SCANNER_IS_DIALOG (self), 0);
+
+  was_empty = self->choices->len == 0;
+
+  g_variant_iter_init (&iter, scanners);
+  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
+    {
+      if (!g_hash_table_contains (self->known, id))
+        {
+          g_hash_table_add (self->known, g_strdup (id));
+          add_scanner_row (self, id, info);
+          added++;
+        }
+      g_variant_unref (info);
+    }
+
+  /* The first scanner that can be used is chosen already, so that one click is enough in the
+   * common case of one scanner. Later ones do not take the choice from the user. */
+  if (was_empty && self->choices->len > 0)
+    {
+      GtkCheckButton *preselected = g_ptr_array_index (self->choices, 0);
+
+      gtk_check_button_set_active (preselected, TRUE);
+      gtk_window_set_focus (GTK_WINDOW (self), GTK_WIDGET (preselected));
+    }
+
+  update_accept_button (self);
+  update_stack (self);
+
+  return added;
+}
+
+void
+scanner_dialog_set_searching (ScannerDialog *self,
+                              gboolean       searching)
+{
+  g_return_if_fail (SCANNER_IS_DIALOG (self));
+
+  self->searching = searching;
+  update_stack (self);
+}
+
 ScannerDialog *
 scanner_dialog_new (const char *app_id,
                     GVariant   *scanners,
@@ -316,14 +390,10 @@ scanner_dialog_new (const char *app_id,
   g_autoptr(GVariantDict) opts = g_variant_dict_new (options);
   g_autofree char *app_name = NULL;
   g_autofree char *heading = NULL;
-  GtkCheckButton *first = NULL;
   guint n_rows = 0;
   const char *accept_label = NULL;
   const char *title = NULL;
   gboolean modal = TRUE;
-  GVariantIter iter;
-  GVariant *info;
-  const char *id;
   ScannerDialog *self;
 
   self = g_object_new (SCANNER_TYPE_DIALOG, NULL);
@@ -332,6 +402,7 @@ scanner_dialog_new (const char *app_id,
   g_variant_dict_lookup (opts, "modal", "b", &modal);
   g_variant_dict_lookup (opts, "accept_label", "&s", &accept_label);
   g_variant_dict_lookup (opts, "title", "&s", &title);
+  g_variant_dict_lookup (opts, "searching", "b", &self->searching);
 
   gtk_window_set_modal (GTK_WINDOW (self), modal);
   gtk_window_set_title (GTK_WINDOW (self), self->multiple ? _("Select Scanners") : _("Select Scanner"));
@@ -363,27 +434,8 @@ scanner_dialog_new (const char *app_id,
       gtk_widget_set_visible (GTK_WIDGET (self->subheading), TRUE);
     }
 
-  g_variant_iter_init (&iter, scanners);
-  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
-    {
-      add_scanner_row (self, id, info, &first);
-      n_rows++;
-      g_variant_unref (info);
-    }
-
-  /* The first scanner that can be used is chosen already, so that one click is enough in the
-   * common case of one scanner. */
-  if (self->choices->len > 0)
-    {
-      GtkCheckButton *preselected = g_ptr_array_index (self->choices, 0);
-
-      gtk_check_button_set_active (preselected, TRUE);
-      gtk_window_set_focus (GTK_WINDOW (self), GTK_WIDGET (preselected));
-    }
-  else
-    gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "empty-state");
-
-  update_accept_button (self);
+  n_rows = scanner_dialog_add_scanners (self, scanners);
+  scanner_dialog_set_searching (self, self->searching);
 
   /* The list sits in a scrolled page, which does not ask for its natural height, so size the
    * window to the list: room for the heading and the header bar, a row each, and no more than
diff --git a/src/scannerdialog.h b/src/scannerdialog.h
index a4db640..21056b9 100644
--- a/src/scannerdialog.h
+++ b/src/scannerdialog.h
@@ -31,5 +31,15 @@ ScannerDialog *scanner_dialog_new (const char *app_id,
                                    GVariant   *scanners,
                                    GVariant   *options);
 
+/* Adds the scanners that have no row yet, a(sa{sv}) as in the portal's calls, and returns how
+ * many rows that made. The first scanner that can be chosen is chosen, if none was. */
+guint scanner_dialog_add_scanners (ScannerDialog *self,
+                                   GVariant      *scanners);
+
+/* Whether more scanners may still come, which the dialog says and which keeps it from telling
+ * the user that there are none */
+void scanner_dialog_set_searching (ScannerDialog *self,
+                                   gboolean       searching);
+
 /* The ids of the scanners the user chose, NULL-terminated; free with g_strfreev () */
 char **scanner_dialog_get_selected (ScannerDialog *self);
