+#define _GNU_SOURCE 1
+
+#include "config.h"
+
+#include <gxdp.h>
+
+#include "xdg-desktop-portal-dbus.h"
+
+#include "request.h"
+#include "utils.h"
+#include "scanner.h"
+#include "scannerdialog.h"
+
+typedef struct
+{
+  XdpImplScanner *impl;
+  GDBusMethodInvocation *invocation;
+  Request *request;
+  ScannerDialog *dialog;
+  GxdpExternalWindow *external_parent;
+
+  guint response;
+} ScannerDialogHandle;
+
+static void
+scanner_dialog_handle_free (gpointer data)
+{
+  ScannerDialogHandle *handle = data;
+
+  g_clear_pointer ((GtkWindow **) &handle->dialog, gtk_window_destroy);
+  g_clear_object (&handle->external_parent);
+  g_clear_object (&handle->request);
+
+  g_free (handle);
+}
+
+static void
+send_response (ScannerDialogHandle *handle)
+{
+  g_auto(GVariantBuilder) results_builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+
+  if (handle->response == XDG_DESKTOP_PORTAL_RESPONSE_SUCCESS)
+    {
+      g_auto(GStrv) selected = scanner_dialog_get_selected (handle->dialog);
+
+      g_variant_builder_add (&results_builder, "{sv}", "scanners",
+                             g_variant_new_strv ((const char * const *) selected, -1));
+    }
+
+  if (handle->request->exported)
+    request_unexport (handle->request);
+
+  xdp_impl_scanner_complete_select_scanners (handle->impl,
+                                             handle->invocation,
+                                             handle->response,
+                                             g_variant_builder_end (&results_builder));
+}
+
+static void
+on_scanner_dialog_response_cb (ScannerDialog       *dialog,
+                               guint                response,
+                               ScannerDialogHandle *handle)
+{
+  switch (response)
+    {
+    default:
+      g_warning ("Unexpected response: %d", response);
+      G_GNUC_FALLTHROUGH;
+
+    case GTK_RESPONSE_DELETE_EVENT:
+      handle->response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+      break;
+
+    case GTK_RESPONSE_CANCEL:
+      handle->response = XDG_DESKTOP_PORTAL_RESPONSE_CANCELLED;
+      break;
+
+    case GTK_RESPONSE_APPLY:
+      handle->response = XDG_DESKTOP_PORTAL_RESPONSE_SUCCESS;
+      break;
+    }
+
+  send_response (handle);
+  scanner_dialog_handle_free (handle);
+}
+
+static gboolean
+on_request_handle_close_cb (XdpImplRequest        *object,
+                            GDBusMethodInvocation *invocation,
+                            ScannerDialogHandle   *handle)
+{
+  scanner_dialog_handle_free (handle);
+
+  return FALSE;
+}
+
+static gboolean
+handle_select_scanners (XdpImplScanner        *object,
+                        GDBusMethodInvocation *invocation,
+                        const char            *arg_handle,
+                        const char            *arg_parent_window,
+                        const char            *arg_app_id,
+                        GVariant              *arg_scanners,
+                        GVariant              *arg_options)
+{
+  g_autoptr(Request) request = NULL;
+  GxdpExternalWindow *external_parent = NULL;
+  ScannerDialogHandle *handle;
+  ScannerDialog *dialog;
+  GdkSurface *surface;
+  GtkWidget *fake_parent;
+  const char *sender;
+
+  sender = g_dbus_method_invocation_get_sender (invocation);
+  request = request_new (sender, arg_app_id, arg_handle);
+
+  handle = g_new0 (ScannerDialogHandle, 1);
+  handle->impl = object;
+  handle->invocation = invocation;
+  handle->request = g_object_ref (request);
+  handle->response = XDG_DESKTOP_PORTAL_RESPONSE_OTHER;
+
+  if (arg_parent_window && *arg_parent_window)
+    {
+      external_parent = gxdp_external_window_new_from_handle (arg_parent_window);
+      if (!external_parent)
+        g_warning ("Failed to associate portal window with parent window %s",
+                   arg_parent_window);
+    }
+
+  handle->external_parent = external_parent;
+
+  fake_parent = g_object_new (GTK_TYPE_WINDOW, NULL);
+  g_object_ref_sink (fake_parent);
+
+  dialog = scanner_dialog_new (arg_app_id, arg_scanners, arg_options);
+  gtk_window_set_transient_for (GTK_WINDOW (dialog), GTK_WINDOW (fake_parent));
+  handle->dialog = g_object_ref_sink (dialog);
+
+  g_signal_connect (request,
+                    "handle-close",
+                    G_CALLBACK (on_request_handle_close_cb),
+                    handle);
+
+  g_signal_connect (dialog,
+                    "response",
+                    G_CALLBACK (on_scanner_dialog_response_cb),
+                    handle);
+
+  gtk_widget_realize (GTK_WIDGET (dialog));
+
+  surface = gtk_native_get_surface (GTK_NATIVE (dialog));
+  if (external_parent)
+    gxdp_external_window_set_parent_of (external_parent, surface);
+
+  gtk_window_present (GTK_WINDOW (dialog));
+
+  request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  return TRUE;
+}
+
+gboolean
+scanner_init (GDBusConnection  *bus,
+              GError          **error)
+{
+  GDBusInterfaceSkeleton *helper;
+
+  helper = G_DBUS_INTERFACE_SKELETON (xdp_impl_scanner_skeleton_new ());
+  g_signal_connect (helper, "handle-select-scanners", G_CALLBACK (handle_select_scanners), NULL);
+  xdp_impl_scanner_set_version (XDP_IMPL_SCANNER (helper), 1);
+
+  if (!g_dbus_interface_skeleton_export (helper,
+                                         bus,
+                                         DESKTOP_PORTAL_OBJECT_PATH,
+                                         error))
+    return FALSE;
+
+  g_debug ("providing %s", g_dbus_interface_skeleton_get_info (helper)->name);
+
+  return TRUE;
+}
