+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gio/gdesktopappinfo.h>
+#include <gio/gio.h>
+#include <glib/gi18n.h>
+#include <adwaita.h>
+
+#include "scannerdialog.h"
+
+struct _ScannerDialog
+{
+  AdwWindow parent;
+
+  GtkButton *accept_button;
+  AdwPreferencesGroup *scanner_list;
+  GtkLabel *heading;
+  GtkLabel *subheading;
+  GtkWidget *stack;
+
+  /* The check button of every row that can be chosen, in list order */
+  GPtrArray *choices;
+  gboolean multiple;
+};
+
+enum
+{
+  RESPONSE,
+  LAST_SIGNAL
+};
+
+static guint signals[LAST_SIGNAL];
+
+G_DEFINE_FINAL_TYPE (ScannerDialog, scanner_dialog, ADW_TYPE_WINDOW)
+
+#define SCANNER_ID_KEY "scanner-id"
+
+static void
+update_accept_button (ScannerDialog *self)
+{
+  gboolean any = FALSE;
+
+  for (guint i = 0; i < self->choices->len; i++)
+    {
+      GtkCheckButton *choice = g_ptr_array_index (self->choices, i);
+
+      if (gtk_check_button_get_active (choice))
+        {
+          any = TRUE;
+          break;
+        }
+    }
+
+  gtk_widget_set_sensitive (GTK_WIDGET (self->accept_button), any);
+}
+
+static void
+on_choice_toggled_cb (GtkCheckButton *choice,
+                      ScannerDialog  *self)
+{
+  update_accept_button (self);
+}
+
+static void
+on_accept_button_clicked_cb (GtkButton     *button,
+                             ScannerDialog *self)
+{
+  g_assert (SCANNER_IS_DIALOG (self));
+
+  g_signal_emit (self, signals[RESPONSE], 0, GTK_RESPONSE_APPLY);
+}
+
+static void
+on_cancel_button_clicked_cb (GtkButton     *button,
+                             ScannerDialog *self)
+{
+  g_assert (SCANNER_IS_DIALOG (self));
+
+  g_signal_emit (self, signals[RESPONSE], 0, GTK_RESPONSE_CANCEL);
+}
+
+static gboolean
+scanner_dialog_close_request (GtkWindow *dialog)
+{
+  g_assert (SCANNER_IS_DIALOG (dialog));
+
+  gtk_widget_set_visible (GTK_WIDGET (dialog), FALSE);
+
+  g_signal_emit (dialog, signals[RESPONSE], 0, GTK_RESPONSE_CANCEL);
+
+  return TRUE;
+}
+
+static void
+scanner_dialog_finalize (GObject *object)
+{
+  ScannerDialog *self = SCANNER_DIALOG (object);
+
+  g_clear_pointer (&self->choices, g_ptr_array_unref);
+
+  G_OBJECT_CLASS (scanner_dialog_parent_class)->finalize (object);
+}
+
+static void
+scanner_dialog_class_init (ScannerDialogClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+  GtkWindowClass *window_class = GTK_WINDOW_CLASS (klass);
+
+  object_class->finalize = scanner_dialog_finalize;
+  window_class->close_request = scanner_dialog_close_request;
+
+  signals[RESPONSE] = g_signal_new ("response",
+                                    G_TYPE_FROM_CLASS (klass),
+                                    G_SIGNAL_ACTION | G_SIGNAL_RUN_LAST,
+                                    0,
+                                    NULL, NULL,
+                                    NULL,
+                                    G_TYPE_NONE, 1, G_TYPE_INT);
+
+  gtk_widget_class_set_template_from_resource (widget_class, "/org/freedesktop/portal/desktop/gnome/scannerdialog.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, accept_button);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, scanner_list);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, heading);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, subheading);
+  gtk_widget_class_bind_template_child (widget_class, ScannerDialog, stack);
+
+  gtk_widget_class_bind_template_callback (widget_class, on_accept_button_clicked_cb);
+  gtk_widget_class_bind_template_callback (widget_class, on_cancel_button_clicked_cb);
+}
+
+static void
+scanner_dialog_init (ScannerDialog *self)
+{
+  self->choices = g_ptr_array_new ();
+
+  gtk_widget_init_template (GTK_WIDGET (self));
+}
+
+static char *
+get_app_display_name (const char *app_id)
+{
+  g_autoptr(GAppInfo) info = NULL;
+  g_autofree char *id = NULL;
+
+  if (!app_id || *app_id == '\0')
+    return NULL;
+
+  id = g_strconcat (app_id, ".desktop", NULL);
+  info = G_APP_INFO (g_desktop_app_info_new (id));
+  if (info)
+    return g_strdup (g_app_info_get_display_name (info));
+
+  return g_strdup (app_id);
+}
+
+/* What the scanner is and how it is connected, from the hints the portal gives. The name of the
+ * scanner comes from the driver and is shown as it is. */
+static char *
+describe_scanner (const char *kind,
+                  const char *type,
+                  const char **capabilities,
+                  gboolean     available)
+{
+  g_autoptr(GPtrArray) parts = g_ptr_array_new_with_free_func (g_free);
+
+  if (g_strcmp0 (kind, "usb") == 0)
+    g_ptr_array_add (parts, g_strdup (_("USB")));
+  else if (g_strcmp0 (kind, "network") == 0)
+    g_ptr_array_add (parts, g_strdup (_("Network")));
+
+  /* Every kind of glass the scanner has, since a multi-function device has two */
+  if (g_strv_contains (capabilities, "film") ||
+      g_strv_contains (capabilities, "flatbed") ||
+      g_strv_contains (capabilities, "adf"))
+    {
+      g_autoptr(GPtrArray) sources = g_ptr_array_new ();
+
+      if (g_strv_contains (capabilities, "flatbed"))
+        g_ptr_array_add (sources, (gpointer) _("Flatbed"));
+      if (g_strv_contains (capabilities, "adf"))
+        g_ptr_array_add (sources, (gpointer) _("Feeder"));
+      if (g_strv_contains (capabilities, "film"))
+        g_ptr_array_add (sources, (gpointer) _("Film"));
+      g_ptr_array_add (sources, NULL);
+
+      g_ptr_array_add (parts, g_strjoinv (" + ", (char **) sources->pdata));
+    }
+  else if (type && *type && g_strcmp0 (type, "virtual device") != 0)
+    g_ptr_array_add (parts, g_strdup (type));
+
+  if (!available)
+    g_ptr_array_add (parts, g_strdup (_("Not available")));
+
+  g_ptr_array_add (parts, NULL);
+
+  return g_strjoinv (" · ", (char **) parts->pdata);
+}
+
+static void
+add_scanner_row (ScannerDialog *self,
+                 const char    *id,
+                 GVariant      *info,
+                 GtkCheckButton **first)
+{
+  g_autoptr(GVariantDict) dict = g_variant_dict_new (info);
+  g_autofree const char **capabilities = NULL;
+  g_autofree char *subtitle = NULL;
+  g_autofree char *title = NULL;
+  const char *name = NULL;
+  const char *vendor = NULL;
+  const char *model = NULL;
+  const char *kind = NULL;
+  const char *type = NULL;
+  gboolean available = TRUE;
+  GtkWidget *row;
+  GtkWidget *choice;
+  GtkWidget *icon;
+
+  g_variant_dict_lookup (dict, "name", "&s", &name);
+  g_variant_dict_lookup (dict, "vendor", "&s", &vendor);
+  g_variant_dict_lookup (dict, "model", "&s", &model);
+  g_variant_dict_lookup (dict, "kind", "&s", &kind);
+  g_variant_dict_lookup (dict, "type", "&s", &type);
+  g_variant_dict_lookup (dict, "available", "b", &available);
+  g_variant_dict_lookup (dict, "capabilities", "^a&s", &capabilities);
+
+  if (name && *name)
+    title = g_strdup (name);
+  else if (vendor && model)
+    title = g_strdup_printf ("%s %s", vendor, model);
+  else
+    title = g_strdup (_("Unknown scanner"));
+
+  subtitle = describe_scanner (kind, type, capabilities ? capabilities : (const char *[]) { NULL }, available);
+
+  row = adw_action_row_new ();
+  adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (row), FALSE);
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), title);
+  if (*subtitle)
+    adw_action_row_set_subtitle (ADW_ACTION_ROW (row), subtitle);
+
+  icon = gtk_image_new_from_icon_name ("scanner-symbolic");
+  adw_action_row_add_prefix (ADW_ACTION_ROW (row), icon);
+
+  choice = gtk_check_button_new ();
+  gtk_widget_set_valign (choice, GTK_ALIGN_CENTER);
+  gtk_widget_add_css_class (choice, "selection-mode");
+  adw_action_row_add_suffix (ADW_ACTION_ROW (row), choice);
+  adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), choice);
+
+  g_object_set_data_full (G_OBJECT (choice), SCANNER_ID_KEY, g_strdup (id), g_free);
+
+  if (!available)
+    {
+      gtk_widget_set_sensitive (row, FALSE);
+    }
+  else
+    {
+      /* One choice at most unless the application can use several: radio behaviour */
+      if (!self->multiple)
+        {
+          if (*first)
+            gtk_check_button_set_group (GTK_CHECK_BUTTON (choice), *first);
+          else
+            *first = GTK_CHECK_BUTTON (choice);
+        }
+
+      g_signal_connect (choice, "toggled", G_CALLBACK (on_choice_toggled_cb), self);
+      g_ptr_array_add (self->choices, choice);
+    }
+
+  adw_preferences_group_add (self->scanner_list, row);
+}
+
+ScannerDialog *
+scanner_dialog_new (const char *app_id,
+                    GVariant   *scanners,
+                    GVariant   *options)
+{
+  g_autoptr(GVariantDict) opts = g_variant_dict_new (options);
+  g_autofree char *app_name = NULL;
+  g_autofree char *heading = NULL;
+  GtkCheckButton *first = NULL;
+  guint n_rows = 0;
+  const char *accept_label = NULL;
+  const char *title = NULL;
+  gboolean modal = TRUE;
+  GVariantIter iter;
+  GVariant *info;
+  const char *id;
+  ScannerDialog *self;
+
+  self = g_object_new (SCANNER_TYPE_DIALOG, NULL);
+
+  g_variant_dict_lookup (opts, "multiple", "b", &self->multiple);
+  g_variant_dict_lookup (opts, "modal", "b", &modal);
+  g_variant_dict_lookup (opts, "accept_label", "&s", &accept_label);
+  g_variant_dict_lookup (opts, "title", "&s", &title);
+
+  gtk_window_set_modal (GTK_WINDOW (self), modal);
+
+  if (accept_label && *accept_label)
+    {
+      gtk_button_set_label (self->accept_button, accept_label);
+      gtk_button_set_use_underline (self->accept_button, TRUE);
+    }
+
+  app_name = get_app_display_name (app_id);
+  if (app_name)
+    heading = self->multiple ? g_strdup_printf (_("%s wants to use the following scanners"), app_name)
+                             : g_strdup_printf (_("%s wants to use a scanner"), app_name);
+  else
+    heading = g_strdup (self->multiple ? _("An app wants to use the following scanners")
+                                       : _("An app wants to use a scanner"));
+  gtk_label_set_label (self->heading, heading);
+
+  /* The application's own words, kept apart from the heading, which is the portal's */
+  if (title && *title)
+    {
+      gtk_label_set_label (self->subheading, title);
+      gtk_label_set_ellipsize (self->subheading, PANGO_ELLIPSIZE_END);
+      gtk_label_set_lines (self->subheading, 2);
+      gtk_widget_set_visible (GTK_WIDGET (self->subheading), TRUE);
+    }
+
+  g_variant_iter_init (&iter, scanners);
+  while (g_variant_iter_next (&iter, "(&s@a{sv})", &id, &info))
+    {
+      add_scanner_row (self, id, info, &first);
+      n_rows++;
+      g_variant_unref (info);
+    }
+
+  /* The first scanner that can be used is chosen already, so that one click is enough in the
+   * common case of one scanner. */
+  if (self->choices->len > 0)
+    gtk_check_button_set_active (g_ptr_array_index (self->choices, 0), TRUE);
+  else
+    gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "empty-state");
+
+  update_accept_button (self);
+
+  /* The list sits in a scrolled page, which does not ask for its natural height, so size the
+   * window to the list: room for the heading and the header bar, a row each, and no more than
+   * about what fits on a small screen. */
+  {
+    int height = n_rows > 0 ? 190 + (int) n_rows * 72 : 320;
+
+    gtk_window_set_default_size (GTK_WINDOW (self), 500, CLAMP (height, 280, 600));
+  }
+
+  return self;
+}
+
+char **
+scanner_dialog_get_selected (ScannerDialog *self)
+{
+  g_autoptr(GStrvBuilder) builder = g_strv_builder_new ();
+
+  g_return_val_if_fail (SCANNER_IS_DIALOG (self), NULL);
+
+  for (guint i = 0; i < self->choices->len; i++)
+    {
+      GtkCheckButton *choice = g_ptr_array_index (self->choices, i);
+
+      if (gtk_check_button_get_active (choice))
+        g_strv_builder_add (builder, g_object_get_data (G_OBJECT (choice), SCANNER_ID_KEY));
+    }
+
+  return g_strv_builder_end (builder);
+}
