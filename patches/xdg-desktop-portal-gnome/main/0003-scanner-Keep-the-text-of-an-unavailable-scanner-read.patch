From 7ee5b7200ffb055f7961ab0a2e9729120b3989ea Mon Sep 17 00:00:00 2001
From: "Christian F.K. Schaller" <christian.schaller@gmail.com>
Date: Mon, 26 Oct 2026 10:32:24 -0400
Subject: [PATCH] scanner: Keep the text of an unavailable scanner readable

This commit dims only the check button of a scanner that is not
available, not the whole row. The subtitle of that row says why the
scanner cannot be chosen, and with the whole row insensitive that text
was pale grey on white in high contrast, which the HIG asks applications
to test.

The row no longer has an activatable widget when the scanner is not
available, so clicking it does nothing, and it is not shaded when the
pointer is over it.

The cost is that an unavailable scanner looks less different from the
others at a glance in the normal style. The cues are the dimmed control
and the words Not available in the subtitle. No colour is added as a
signal.

Checked by hand on a Wayland session with made-up scanners: the row in
the normal style and in high contrast (ADW_DEBUG_HIGH_CONTRAST), a click
on the row doing nothing, and Escape still answering cancelled. Dark mode
was checked before this change and not after it.
---
 src/scannerdialog.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/scannerdialog.c b/src/scannerdialog.c
index df62649..b57a2e2 100644
--- a/src/scannerdialog.c
+++ b/src/scannerdialog.c
@@ -271,7 +271,6 @@ add_scanner_row (ScannerDialog *self,
   gtk_widget_set_valign (choice, GTK_ALIGN_CENTER);
   gtk_widget_add_css_class (choice, "selection-mode");
   adw_action_row_add_suffix (ADW_ACTION_ROW (row), choice);
-  adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), choice);
 
   /* The control takes keyboard focus, not the row, and a screen reader needs the scanner's name
    * on it, since the control has no text of its own. */
@@ -285,10 +284,14 @@ add_scanner_row (ScannerDialog *self,
 
   if (!available)
     {
-      gtk_widget_set_sensitive (row, FALSE);
+      /* Only the control is dimmed. The text says why the scanner cannot be chosen, so it stays
+       * at the contrast of the other rows, which matters most in high contrast. */
+      gtk_widget_set_sensitive (choice, FALSE);
     }
   else
     {
+      adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), choice);
+
       /* One choice at most unless the application can use several: radio behaviour */
       if (!self->multiple)
         {
